{%- doc -%}
  AP-56 · Editorial card: full-bleed image with an eyebrow, and a frosted text
  panel (title, text, link) along the bottom. The whole card is clickable when a
  link is set.
{%- enddoc -%}

{%- assign s = block.settings -%}
<div
  class="ap-editorial-card"
  style="--ap-card-ratio: {{ s.aspect_ratio }};"
  {{ block.shopify_attributes }}
>
  {%- if s.image != blank -%}
    {{
      s.image
      | image_url: width: 1040
      | image_tag:
        loading: 'lazy',
        widths: '360, 540, 720, 1040',
        sizes: '(min-width: 750px) 360px, 75vw',
        alt: s.image.alt,
        class: 'ap-editorial-card__image'
    }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'ap-editorial-card__image ap-editorial-card__image--placeholder' }}
  {%- endif -%}

  {%- if s.eyebrow != blank -%}
    <p class="ap-editorial-card__eyebrow">{{ s.eyebrow | escape }}</p>
  {%- endif -%}

  <div class="ap-editorial-card__content">
    {%- if s.title != blank -%}
      <p class="ap-editorial-card__title">{{ s.title | escape }}</p>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="ap-editorial-card__text">{{ s.text | escape }}</p>
    {%- endif -%}
    {%- if s.link_label != blank -%}
      <a
        class="ap-editorial-card__link"
        {% if s.link != blank %}
          href="{{ s.link }}"
        {% else %}
          role="link"
          aria-disabled="true"
        {% endif %}
      >
        <span class="ap-editorial-card__link-label">{{ s.link_label | escape }}</span>
        <span class="ap-editorial-card__link-icon" aria-hidden="true">{% render 'ap-button-icon' %}</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ap-editorial-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: var(--ap-card-ratio, 4 / 5);
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: var(--ap-surface-inverse, #1a1a1a);
    color: var(--ap-text-inverse-primary, #fff);
    isolation: isolate;
  }

  .ap-editorial-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }

  .ap-editorial-card__image--placeholder {
    background-color: var(--ap-primitive-neutral-700, #696969);
    fill: rgb(255 255 255 / 0.25);
  }

  .ap-editorial-card__eyebrow {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-start: 1rem;
    margin: 0;
    font-family: var(--font-ap-label-lg--family, var(--font-accent--family));
    font-weight: 700;
    font-size: var(--font-ap-label-lg--size, 0.875rem);
    letter-spacing: var(--font-ap-label-lg--letter-spacing, 0.1em);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ap-editorial-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    background-color: rgb(120 120 120 / 0.45);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .ap-editorial-card__title {
    margin: 0;
    font-family: var(--font-ap-title-card--family, var(--font-heading--family));
    font-weight: var(--font-ap-title-card--weight, 700);
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: var(--font-ap-title-card--letter-spacing, -0.015em);
  }

  .ap-editorial-card__text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .ap-editorial-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    margin-block-start: 0.25rem;
    color: var(--ap-surface-accent, #fbec00);
    font-family: var(--font-ap-button--family, var(--font-accent--family));
    font-weight: var(--font-ap-button--weight, 700);
    font-size: var(--font-ap-button--size, 1rem);
    letter-spacing: var(--font-ap-button--letter-spacing, 0.1em);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* Stretch the link over the whole card. */
  .ap-editorial-card__link[href]::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ap-editorial-card__link-label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .ap-editorial-card__link-icon {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
  }

  .ap-editorial-card__link-icon svg {
    width: 100%;
    height: 100%;
  }

  .ap-editorial-card:has(.ap-editorial-card__link:focus-visible) {
    outline: var(--ap-focus-ring-width, 2px) solid var(--ap-focus-ring-outer, currentColor);
    outline-offset: 3px;
  }

  .ap-editorial-card__link:focus-visible {
    outline: none;
  }

  @media screen and (max-width: 749px) {
    .ap-editorial-card__eyebrow {
      inset-block-start: 1rem;
      inset-inline-start: 1rem;
      font-size: 0.75rem;
    }

    .ap-editorial-card__content {
      gap: 0.5rem;
      padding: 1rem;
    }

    .ap-editorial-card__title {
      font-size: 1.25rem;
    }

    .ap-editorial-card__text {
      font-size: 0.8125rem;
    }

    .ap-editorial-card__link {
      font-size: 0.875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Tall (3:4)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Card title"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Editorial card"
    }
  ]
}
{% endschema %}
