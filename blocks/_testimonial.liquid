{%- liquid
  assign bs = block.settings
  assign is_media = false
  if bs.style == 'image' or bs.style == 'video'
    assign is_media = true
  endif
  assign rating = bs.rating | at_most: 5 | at_least: 0
  assign poster = bs.image
  if bs.style == 'video' and poster == blank and bs.video != blank
    assign poster = bs.video.preview_image
  endif
  assign fallback = 'ascent-review-image.jpg'
  if bs.style == 'video'
    assign fallback = 'ascent-review-video.jpg'
  endif
-%}
<div
  class="testimonial testimonial--{{ bs.style }}"
  ref="slides[]"
  data-carousel-card
  {{ block.shopify_attributes }}
>
  {%- if is_media -%}
    <div class="testimonial__media">
      {%- if poster != blank -%}
        {{
          poster
          | image_url: width: 640
          | image_tag: widths: '300, 400, 640', sizes: '(min-width: 750px) 300px, 280px', loading: 'lazy', class: 'testimonial__image', alt: poster.alt | default: bs.handle
        }}
      {%- elsif section.settings.placeholder_media -%}
        <img
          class="testimonial__image"
          src="{{ fallback | asset_url }}"
          alt=""
          width="600"
          height="1066"
          loading="lazy"
        >
      {%- endif -%}
      {%- if bs.style == 'video' and bs.video != blank -%}
        <testimonial-video class="testimonial__video">
          <template>
            {{ bs.video | video_tag: playsinline: true, controls: true, preload: 'metadata', class: 'testimonial__video-el' }}
          </template>
          <button type="button" class="testimonial__play" aria-label="{{ 'accessibility.play_video' | t }}">
            <svg viewBox="0 0 22 22" aria-hidden="true" focusable="false"><path d="M3 0v22l19-11z" fill="currentColor"/></svg>
          </button>
        </testimonial-video>
      {%- elsif bs.style == 'video' -%}
        <span class="testimonial__play" aria-hidden="true">
          <svg viewBox="0 0 22 22" focusable="false"><path d="M3 0v22l19-11z" fill="currentColor"/></svg>
        </span>
      {%- endif -%}
    </div>
    {%- if bs.handle != blank -%}
      <p class="testimonial__handle body-sm">{{ bs.handle }}</p>
    {%- endif -%}
  {%- else -%}
    <figure class="testimonial__quote">
      {%- if rating > 0 -%}
        <p class="testimonial__stars" role="img" aria-label="{{ 'accessibility.rating_label' | t: rating: rating, max: 5 }}">
          {%- for i in (1..rating) -%}★{%- endfor -%}
        </p>
      {%- endif -%}
      {%- if bs.headline != blank -%}
        <blockquote class="testimonial__headline h4">{{ bs.headline }}</blockquote>
      {%- endif -%}
      {%- if bs.body != blank -%}
        <div class="testimonial__body body-md">{{ bs.body }}</div>
      {%- endif -%}
      {%- if bs.name != blank or bs.verified -%}
        <figcaption class="testimonial__attribution">
          {%- if bs.name != blank -%}
            <span class="testimonial__name label-sm">{{ bs.name }}</span>
          {%- endif -%}
          {%- if bs.verified -%}
            <span class="testimonial__verified label-sm">
              {{- bs.verified_label -}}
              <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                <circle cx="7" cy="7" r="5.83" fill="currentColor"/>
                <path d="M4.375 7.233 6.125 8.983 9.625 5.25" fill="none" stroke="var(--testimonial-bg)" stroke-width="1.283" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {%- endif -%}
          {%- if bs.handle != blank -%}
            <span class="testimonial__handle body-sm">{{ bs.handle }}</span>
          {%- endif -%}
        </figcaption>
      {%- endif -%}
    </figure>
  {%- endif -%}
</div>

{% javascript %}
  if (!customElements.get('testimonial-video')) {
    customElements.define(
      'testimonial-video',
      class extends HTMLElement {
        connectedCallback() {
          this.querySelector('button')?.addEventListener('click', () => {
            const template = this.querySelector('template');
            if (!template) return;
            this.replaceChildren(template.content.cloneNode(true));
            this.querySelector('video')?.play();
          });
        }
      }
    );
  }
{% endjavascript %}

{% stylesheet %}
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: center;
  }

  .testimonial__media,
  .testimonial__quote {
    position: relative;
    aspect-ratio: 300 / 533;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
  }

  .testimonial__image,
  .testimonial__video,
  .testimonial__video-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial__video {
    display: grid;
    place-items: center;
  }

  .testimonial__play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--testimonial-play-color, #f8f8f8);
    cursor: pointer;
  }

  .testimonial__play svg {
    width: 22px;
    height: 22px;
    margin-inline-start: 4px;
  }

  .testimonial__handle {
    margin: 0;
    color: var(--testimonial-handle-color, currentColor);
  }

  .testimonial__quote {
    --testimonial-bg: var(--testimonial-dark-bg);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 0;
    padding: 28px;
    background: var(--testimonial-bg);
    color: var(--testimonial-dark-text);
  }

  .testimonial--quote_accent .testimonial__quote {
    --testimonial-bg: var(--testimonial-accent-bg);

    color: var(--testimonial-accent-text);
  }

  .testimonial__stars {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .testimonial__headline {
    margin: 0;
    color: inherit;
  }

  .testimonial__body {
    color: inherit;
  }

  .testimonial__body p {
    margin: 0;
  }

  .testimonial__attribution {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .testimonial__name {
    font-weight: 700;
    text-transform: uppercase;
  }

  .testimonial__verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
  }

  .testimonial__verified svg {
    width: 14px;
    height: 14px;
  }

  @media screen and (max-width: 749px) {
    .testimonial {
      gap: 12px;
    }

    .testimonial__media,
    .testimonial__quote {
      aspect-ratio: 280 / 498;
    }

    .testimonial__stars {
      font-family: var(--font-accent--family);
      font-size: 1rem;
      letter-spacing: 0.1em;
    }

    .testimonial__name.label-sm {
      font-size: 0.6875rem;
      line-height: 16px;
    }

    .testimonial__headline.h4 {
      font-size: var(--font-h2--size);
      line-height: 1.06;
      letter-spacing: -0.02em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.testimonial",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "options": [
        { "value": "quote_dark", "label": "t:options.quote_dark" },
        { "value": "quote_accent", "label": "t:options.quote_accent" },
        { "value": "image", "label": "t:options.image" },
        { "value": "video", "label": "t:options.video" }
      ],
      "default": "quote_dark"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:settings.rating",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ block.settings.style == 'quote_dark' or block.settings.style == 'quote_accent' }}"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "t:settings.quote_headline",
      "default": "“Mixes clean, no chalk”",
      "visible_if": "{{ block.settings.style == 'quote_dark' or block.settings.style == 'quote_accent' }}"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:settings.text",
      "visible_if": "{{ block.settings.style == 'quote_dark' or block.settings.style == 'quote_accent' }}"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:settings.reviewer_name",
      "default": "Marcus D.",
      "visible_if": "{{ block.settings.style == 'quote_dark' or block.settings.style == 'quote_accent' }}"
    },
    {
      "type": "checkbox",
      "id": "verified",
      "label": "t:settings.verified_buyer",
      "default": true,
      "visible_if": "{{ block.settings.style == 'quote_dark' or block.settings.style == 'quote_accent' }}"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "t:settings.verified_label",
      "default": "Verified buyer",
      "visible_if": "{{ block.settings.verified and block.settings.style != 'image' and block.settings.style != 'video' }}"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "t:settings.handle",
      "info": "t:info.testimonial_handle"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.style == 'image' or block.settings.style == 'video' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.style == 'video' }}"
    }
  ]
}
{% endschema %}
