

{% liquid
  assign product = closest.product

  # AP-60 · Merchandising badge (e.g. "Bestseller") driven by a product tag, so
  # merchants can flag any product. Figma Product Card › Badge row (top-right).
  assign show_tag_badge = false
  assign badge_tag = block.settings.badge_tag | strip | downcase
  if block.settings.show_tag_badge and badge_tag != blank and product != blank
    for tag in product.tags
      assign tag_handle = tag | strip | downcase
      if tag_handle == badge_tag
        assign show_tag_badge = true
        break
      endif
    endfor
  endif

  # Keep clear of the sale / sold-out badge when it is also set to top-right.
  assign tag_badge_position = 'top-right'
  if settings.badge_position == 'top-right'
    assign tag_badge_position = 'top-left'
  endif
%}

{% capture children %}
  {% if show_tag_badge %}
    <div class="product-badges product-badges--{{ tag_badge_position }}">
      <span class="ap-tag-badge">{{ block.settings.badge_label | escape }}</span>
    </div>
  {% endif %}
  {% unless product == blank %}
    {%- if product.available == false or product.compare_at_price > product.price -%}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
        style="
            --badge-border-radius: {{ settings.badge_corner_radius }}px;
            --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %} color-custom-badge-sale{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- elsif product.compare_at_price > product.price -%}
            {{ 'content.product_badge_sale' | t }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {% if product.available and settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title for the zoomed out grid view %}
<h3 class="product-grid-view-zoom-out--details">
  {%- if product == blank -%}
    {{- 'content.product_card_placeholder' | t -}}
  {%- else -%}
    {{- product.title -}}
  {%- endif -%}
</h3>

{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}

{% stylesheet %}
  /* AP-60 · Product Card badge: lemon fill, ink mono label (AP-49 Label Small). */
  .ap-tag-badge {
    display: inline-flex;
    align-items: center;
    padding-block: 0.375rem;
    padding-inline: 0.625rem;
    border-radius: 6.25rem;
    background-color: var(--ap-surface-accent, #fbec00);
    color: var(--ap-text-on-accent, #1a1a1a);
    font-family: var(--font-ap-label-sm--family, var(--font-body--family));
    font-weight: var(--font-ap-label-sm--weight, 500);
    font-size: var(--font-ap-label-sm--size, 0.75rem);
    line-height: var(--font-ap-label-sm--line-height, 1);
    letter-spacing: var(--font-ap-label-sm--letter-spacing, 0.04em);
    text-transform: uppercase;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "header",
      "content": "Tag badge"
    },
    {
      "type": "checkbox",
      "id": "show_tag_badge",
      "label": "Show tag badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_tag",
      "label": "Product tag",
      "info": "Products with this tag show the badge.",
      "default": "bestseller",
      "visible_if": "{{ block.settings.show_tag_badge }}"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Bestseller",
      "visible_if": "{{ block.settings.show_tag_badge }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
