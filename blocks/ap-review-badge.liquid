{%- doc -%}
  AP-15 · Review badge block (Ascent).

  Star rating over a mono review-count label, with an optional vertical rule on
  the leading edge (Figma Stars Row 811:13110 desktop / 811:12824 mobile).
  Optionally links to the reviews (e.g. "#reviews" or a reviews page).
  Reusable in any section that accepts @theme blocks.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign rating = bs.rating | default: 5
  assign element = 'div'
  if bs.link != blank
    assign element = 'a'
  endif

  assign star_count = bs.rating | round
  capture aria_label
    echo rating | append: ' out of 5 stars'
    if bs.label != blank
      echo ', ' | append: bs.label
    endif
  endcapture
-%}

<{{ element }}
  class="ap-review-badge{% if bs.show_divider %} ap-review-badge--divider{% endif %}{% if bs.uppercase %} ap-review-badge--upper{% endif %}"
  {% if element == 'a' %}
    href="{{ bs.link }}" aria-label="{{ aria_label | strip | escape }}"
  {% endif %}
  style="
    --ap-review-star: {{ bs.star_color }};
    --ap-review-space: {{ bs.space_above_mobile }}px;
    --ap-review-space-desktop: {{ bs.space_above }}px;
    {% if bs.text_color != blank and bs.text_color.alpha != 0 %}color: {{ bs.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <span class="ap-review-badge__body">
    <span class="ap-review-badge__stars" role="img" aria-label="{{ rating }} out of 5 stars">
      {%- for i in (1..5) -%}
        <svg
          class="ap-review-badge__star{% if i > star_count %} ap-review-badge__star--empty{% endif %}"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 2.5l2.94 6.24 6.81.83-5.02 4.7 1.3 6.73L12 17.68 5.97 21l1.3-6.73-5.02-4.7 6.81-.83L12 2.5z"/>
        </svg>
      {%- endfor -%}
    </span>
    {%- if bs.label != blank -%}
      <span class="ap-review-badge__label">{{ bs.label | escape }}</span>
    {%- endif -%}
  </span>
</{{ element }}>

{% stylesheet %}
  .ap-review-badge {
    --ap-review-star-size: 1.125rem;
    --ap-review-row-gap: 0.375rem;
    --ap-review-rule-gap: 0.75rem;

    display: inline-flex;
    align-items: stretch;
    gap: var(--ap-review-rule-gap);
    margin-block-start: var(--ap-review-space);
    color: inherit;
    text-decoration: none;
    text-align: start;
  }

  .ap-review-badge--divider::before {
    content: '';
    flex: none;
    inline-size: 1px;
    background-color: currentcolor;
    opacity: 0.4;
  }

  .ap-review-badge__body {
    display: flex;
    flex-direction: column;
    gap: var(--ap-review-row-gap);
  }

  .ap-review-badge__stars {
    display: inline-flex;
    gap: 0.0625rem;
    color: var(--ap-review-star);
  }

  .ap-review-badge__star {
    inline-size: var(--ap-review-star-size);
    block-size: var(--ap-review-star-size);
    fill: currentcolor;
  }

  .ap-review-badge__star--empty {
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.5;
  }

  /* Label Small (mobile) → Label Large (desktop), AP-49 tokens · IBM Plex Mono */
  .ap-review-badge__label {
    font-family: var(--font-ap-label-sm--family);
    font-style: var(--font-ap-label-sm--style);
    font-weight: var(--font-ap-label-sm--weight);
    font-size: var(--font-ap-label-sm--size);
    line-height: var(--font-ap-label-sm--line-height);
    letter-spacing: var(--font-ap-label-sm--letter-spacing);
  }

  .ap-review-badge--upper .ap-review-badge__label {
    text-transform: uppercase;
  }

  a.ap-review-badge:hover .ap-review-badge__label {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media screen and (min-width: 750px) {
    .ap-review-badge {
      --ap-review-star-size: 1.5rem;
      --ap-review-row-gap: 1rem;
      --ap-review-rule-gap: 0.875rem;

      margin-block-start: var(--ap-review-space-desktop);
    }

    .ap-review-badge__label {
      font-family: var(--font-ap-label-lg--family);
      font-style: var(--font-ap-label-lg--style);
      font-weight: var(--font-ap-label-lg--weight);
      font-size: var(--font-ap-label-lg--size);
      line-height: var(--font-ap-label-lg--line-height);
      letter-spacing: var(--font-ap-label-lg--letter-spacing);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Review badge",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "label": "Stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "12,000+ five star reviews"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase label",
      "default": true
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Use an anchor such as #reviews or a reviews page."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider line",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FBEC00"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the section text color."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "space_above",
      "label": "Extra space above (desktop)",
      "info": "Added to the section's space between blocks.",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "space_above_mobile",
      "label": "Extra space above (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Review badge",
      "category": "Text"
    }
  ]
}
{% endschema %}
