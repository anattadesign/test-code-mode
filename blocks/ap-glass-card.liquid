{%- doc -%}
  AP-29 · Glass card block (Ascent).

  Frosted-glass panel for use over imagery: a large number at the top, and a
  title + short text pinned to the bottom (About Ascent panels, Figma 811:13145 /
  811:12850). The whole card becomes clickable when a link is set.
  Sized by its parent (e.g. Card row); on its own it fills the available width.
  Reusable in any section that accepts @theme blocks.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign tint_alpha = bs.tint_opacity | divided_by: 100.0
  assign tint = bs.tint_color | color_modify: 'alpha', tint_alpha
-%}

<div
  class="ap-glass-card{% if bs.link != blank %} ap-glass-card--link{% endif %}"
  style="--ap-glass-tint: {{ tint }}; --ap-glass-blur: {{ bs.blur }}px;"
  {{ block.shopify_attributes }}
>
  {%- if bs.number != blank -%}
    <p class="ap-glass-card__number" aria-hidden="true">{{ bs.number | escape }}</p>
  {%- endif -%}

  <div class="ap-glass-card__body">
    {%- if bs.title != blank -%}
      <{{ bs.title_tag | default: 'h3' }} class="ap-glass-card__title">
        {%- if bs.link != blank -%}
          <a class="ap-glass-card__link" href="{{ bs.link }}">{{ bs.title | escape }}</a>
        {%- else -%}
          {{ bs.title | escape }}
        {%- endif -%}
      </{{ bs.title_tag | default: 'h3' }}>
    {%- endif -%}
    {%- if bs.text != blank -%}
      <p class="ap-glass-card__text">{{ bs.text | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ap-glass-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    box-sizing: border-box;
    padding: 2rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 1rem;
    color: var(--ap-glass-text, var(--color, #fff));
    background-color: var(--ap-glass-tint, rgb(255 255 255 / 0.04));
    background-image: linear-gradient(160deg, rgb(255 255 255 / 0.06) 0%, rgb(255 255 255 / 0) 55%);
    backdrop-filter: blur(var(--ap-glass-blur, 24px));
    -webkit-backdrop-filter: blur(var(--ap-glass-blur, 24px));
    overflow: hidden;
  }

  .ap-glass-card__number {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .ap-glass-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ap-glass-card__title {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1;
    /* Tight tracking matches the Figma display face (Neue Haas) with the Inter stand-in. */
    letter-spacing: -0.05em;
    text-wrap: pretty;
  }

  .ap-glass-card__text {
    margin: 0;
    font-family: var(--font-ap-body-lg--family);
    font-style: var(--font-ap-body-lg--style);
    font-weight: var(--font-ap-body-lg--weight);
    font-size: var(--font-ap-body-lg--size);
    line-height: var(--font-ap-body-lg--line-height);
    letter-spacing: var(--font-ap-body-lg--letter-spacing);
  }

  .ap-glass-card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the title link over the whole card. */
  .ap-glass-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .ap-glass-card--link:hover {
    border-color: rgb(255 255 255 / 0.5);
  }

  .ap-glass-card:has(.ap-glass-card__link:focus-visible) {
    outline: var(--ap-focus-ring-width, 2px) solid currentcolor;
    outline-offset: 3px;
  }

  .ap-glass-card__link:focus-visible {
    outline: none;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .ap-glass-card {
      background-color: rgb(26 26 26 / 0.6);
    }
  }

  @media screen and (min-width: 750px) {
    .ap-glass-card__number {
      font-size: 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glass card",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Number",
      "info": "Decorative, e.g. 01. Hidden from screen readers.",
      "default": "01"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Card title"
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Title HTML tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h3"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Short supporting text for this card."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the whole card clickable."
    },
    {
      "type": "header",
      "content": "Glass"
    },
    {
      "type": "color",
      "id": "tint_color",
      "label": "Tint color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "tint_opacity",
      "label": "Tint opacity",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 4
    },
    {
      "type": "range",
      "id": "blur",
      "label": "Background blur",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Glass card",
      "category": "Cards"
    }
  ]
}
{% endschema %}
