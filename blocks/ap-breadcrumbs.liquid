{%- doc -%}
  AP-61 · Breadcrumbs (Ascent).

  "HOME / COLLECTIONS / ALL PRODUCTS" trail from the PLP page head
  (Figma 1906:24320 desktop · 1906:22825 mobile) — Label Small, mono, uppercase.

  Generic: builds the trail from the current page (collection, product, page,
  blog, article, search), so it works in any section that accepts @theme blocks.
  Emits BreadcrumbList structured data.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign separator = bs.separator | default: '/'

  assign crumbs_labels = ''
  assign crumbs_urls = ''
  assign current_label = ''

  case request.page_type
    when 'collection'
      if bs.show_collections_link
        assign crumbs_labels = bs.collections_label | default: 'Collections'
        assign crumbs_urls = routes.collections_url
      endif
      assign current_label = collection.title
    when 'product'
      if collection and collection.handle != blank
        assign crumbs_labels = collection.title
        assign crumbs_urls = collection.url
      endif
      assign current_label = product.title
    when 'article'
      assign crumbs_labels = blog.title
      assign crumbs_urls = blog.url
      assign current_label = article.title
    when 'blog'
      assign current_label = blog.title
    when 'page'
      assign current_label = page.title
    when 'search'
      assign current_label = 'content.search_results' | t
    when 'list-collections'
      assign current_label = bs.collections_label | default: 'Collections'
    else
      assign current_label = page_title
  endcase

  assign mid_labels = crumbs_labels | split: '||'
  assign mid_urls = crumbs_urls | split: '||'
-%}

<nav
  class="ap-breadcrumbs ap-label-sm{% if bs.uppercase %} ap-breadcrumbs--upper{% endif %}"
  aria-label="Breadcrumb"
  style="--ap-breadcrumbs-color: {{ bs.color | default: 'currentColor' }};"
  {{ block.shopify_attributes }}
>
  <ol class="ap-breadcrumbs__list">
    <li class="ap-breadcrumbs__item">
      <a class="ap-breadcrumbs__link" href="{{ routes.root_url }}">{{ bs.home_label | default: 'Home' }}</a>
    </li>
    {%- for label in mid_labels -%}
      {%- if label != blank -%}
        <li class="ap-breadcrumbs__item">
          <span class="ap-breadcrumbs__sep" aria-hidden="true">{{ separator }}</span>
          <a class="ap-breadcrumbs__link" href="{{ mid_urls[forloop.index0] }}">{{ label | escape }}</a>
        </li>
      {%- endif -%}
    {%- endfor -%}
    {%- if current_label != blank -%}
      <li class="ap-breadcrumbs__item">
        <span class="ap-breadcrumbs__sep" aria-hidden="true">{{ separator }}</span>
        <span class="ap-breadcrumbs__current" aria-current="page">{{ current_label | escape }}</span>
      </li>
    {%- endif -%}
  </ol>
</nav>

{%- if request.design_mode == false and current_label != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ bs.home_label | default: 'Home' | json }}, "item": {{ shop.url | append: routes.root_url | json }} }
        {%- assign position = 1 -%}
        {%- for label in mid_labels -%}
          {%- if label != blank -%}
            {%- assign position = position | plus: 1 -%}
            ,{ "@type": "ListItem", "position": {{ position }}, "name": {{ label | json }}, "item": {{ shop.url | append: mid_urls[forloop.index0] | json }} }
          {%- endif -%}
        {%- endfor -%}
        {%- assign position = position | plus: 1 -%}
        ,{ "@type": "ListItem", "position": {{ position }}, "name": {{ current_label | json }} }
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .ap-breadcrumbs {
    color: var(--ap-breadcrumbs-color, currentColor);
  }

  .ap-breadcrumbs--upper {
    text-transform: uppercase;
  }

  .ap-breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ap-breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .ap-breadcrumbs__link {
    color: inherit;
    text-decoration: none;
  }

  .ap-breadcrumbs__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Breadcrumbs (Ascent)",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_collections_link",
      "label": "Show Collections link on collection pages",
      "default": true
    },
    {
      "type": "text",
      "id": "collections_label",
      "label": "Collections label",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "/"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": true
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text colour",
      "info": "Leave empty to follow the section text colour."
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs (Ascent)",
      "category": "Links"
    }
  ]
}
{% endschema %}
