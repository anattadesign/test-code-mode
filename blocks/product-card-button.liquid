{%- doc -%}
  Product card call-to-action: renders the Ascent button system linking to the card's product.
{%- enddoc -%}
{%- liquid
  assign product = closest.product
  assign product_link = product.url
  if product == blank
    assign product_link = routes.all_products_collection_url
  endif
-%}
<div class="product-card-button">
  {% render 'button', link: product_link, block: block %}
</div>

{% stylesheet %}
  .product-card-button {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    justify-content: var(--product-card-alignment, flex-start);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_card_button",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.product_card_button_info"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Shop now"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-tertiary",
          "label": "t:options.tertiary"
        },
        {
          "value": "button-dark",
          "label": "t:options.dark"
        },
        {
          "value": "button-unstyled",
          "label": "t:options.link"
        },
        {
          "value": "button-custom",
          "label": "t:options.custom"
        }
      ],
      "default": "button",
      "info": "t:info.edit_button_style_in_theme_settings"
    },
    {
      "type": "select",
      "id": "secondary_tone",
      "label": "t:settings.button_tone",
      "options": [
        {
          "value": "accent",
          "label": "t:options.button_tone_accent"
        },
        {
          "value": "palette",
          "label": "t:options.button_tone_palette"
        }
      ],
      "default": "accent",
      "info": "t:info.button_tone",
      "visible_if": "{{ block.settings.style_class == 'button-secondary' }}"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "t:settings.button_show_arrow",
      "default": false,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "link_text_color",
      "label": "t:settings.link_text_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.style_class == 'button-unstyled' or block.settings.style_class == 'button-tertiary' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_button"
    }
  ]
}
{% endschema %}
