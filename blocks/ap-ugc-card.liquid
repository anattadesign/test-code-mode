{%- doc -%}
  AP-63 · UGC card block (Ascent).

  Customer photo or short video with a handle under it (Figma Reviews Rail ›
  UGC Card / @marcus.trains, 300 × 533 media + 18px caption). Videos play muted
  and looped. Reusable in any section that accepts @theme blocks.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
-%}

<figure class="ap-ugc-card" {{ block.shopify_attributes }}>
  <div class="ap-ugc-card__media">
    {%- if bs.video != blank -%}
      {{
        bs.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'none',
          image_size: '600x',
          class: 'ap-ugc-card__asset'
      }}
    {%- elsif bs.image != blank -%}
      {{
        bs.image
        | image_url: width: 900
        | image_tag:
          widths: '300, 450, 600, 900',
          sizes: '300px',
          loading: 'lazy',
          alt: bs.image.alt | default: bs.handle,
          class: 'ap-ugc-card__asset'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ap-ugc-card__asset ap-ugc-card__placeholder' }}
    {%- endif -%}
  </div>
  {%- if bs.handle != blank -%}
    <figcaption class="ap-ugc-card__caption">
      {%- if bs.link != blank -%}
        <a href="{{ bs.link }}" target="_blank" rel="noopener">{{ bs.handle | escape }}</a>
      {%- else -%}
        {{ bs.handle | escape }}
      {%- endif -%}
    </figcaption>
  {%- endif -%}
</figure>

{% stylesheet %}
  .ap-ugc-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    block-size: 100%;
    margin: 0;
  }

  .ap-ugc-card__media {
    position: relative;
    flex: 1 1 auto;
    aspect-ratio: 300 / 533;
    overflow: hidden;
    border-radius: var(--ap-rail-radius, 16px);
    background-color: var(--ap-surface-sunken, #f0f0f0);
  }

  .ap-ugc-card__asset {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .ap-ugc-card__caption {
    font-family: var(--font-ap-label-sm--family, var(--font-body--family));
    font-size: var(--font-ap-label-sm--size, 0.75rem);
    letter-spacing: var(--font-ap-label-sm--letter-spacing, 0.04em);
    text-align: center;
  }

  .ap-ugc-card__caption a {
    color: inherit;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UGC card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on loop. Overrides the image."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@marcus.trains"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "UGC card",
      "category": "Media"
    }
  ]
}
{% endschema %}
