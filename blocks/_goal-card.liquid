{%- comment -%}
  Ascent "Shop by goal" card (WAK-32): 4:5 image with gradient, glass footer with title + sub-label and a yellow arrow.
  No link = disabled state (not focusable, aria-disabled, desaturated image, grey arrow, optional "Coming soon" chip).
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign disabled = false
  if bs.link == blank
    assign disabled = true
  endif
  assign tag = 'a'
  if disabled
    assign tag = 'div'
  endif
-%}
<{{ tag }}
  class="goal-card{% if disabled %} goal-card--disabled{% endif %}"
  {% if disabled %}
    aria-disabled="true"
  {% else %}
    href="{{ bs.link }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <span class="goal-card__media">
    {%- if bs.image != blank -%}
      {{
        bs.image
        | image_url: width: 640
        | image_tag:
          class: 'goal-card__image',
          alt: '',
          loading: 'lazy',
          sizes: '(min-width: 750px) 312px, 236px',
          widths: '320, 480, 640'
      }}
    {%- elsif bs.sample != 'none' -%}
      <img
        class="goal-card__image"
        src="{{ 'ascent-goal-' | append: bs.sample | append: '.jpg' | asset_url }}"
        alt=""
        width="624"
        height="780"
        loading="lazy"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'goal-card__image goal-card__image--placeholder' }}
    {%- endif -%}
  </span>

  {%- if disabled and section.settings.disabled_label != blank -%}
    <span class="goal-card__status label-sm">{{ section.settings.disabled_label }}</span>
  {%- endif -%}

  <span class="goal-card__footer">
    <span class="goal-card__body">
      {%- if disabled == false and section.settings.link_prefix != blank -%}
        <span class="visually-hidden">{{ section.settings.link_prefix }}</span>
      {%- endif -%}
      <span class="goal-card__title title-card">{{ bs.title }}</span>
      {%- if bs.subtitle != blank -%}
        <span class="goal-card__title title-card">{{ bs.subtitle }}</span>
      {%- endif -%}
    </span>
    <span class="goal-card__icon" aria-hidden="true">
      <svg viewBox="0 0 20 20" focusable="false"><path d="M6.843 4.736v1.053h6.626l-8.732 8.731.742.742 8.732-8.731v6.626h1.053V4.736z" fill="currentColor"/></svg>
    </span>
  </span>
</{{ tag }}>

{% stylesheet %}
  .goal-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 12px;
    color: var(--goal-card-text, #fff);
    text-decoration: none;
    isolation: isolate;
  }

  .goal-card__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .goal-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.5), rgb(102 102 102 / 0));
  }

  .goal-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--animation-easing, ease);
  }

  .goal-card:not(.goal-card--disabled):hover .goal-card__image {
    transform: scale(1.04);
  }

  .goal-card__footer {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--goal-card-band, 88px);
    padding: var(--goal-card-band-padding, 16px);
    background-color: rgb(217 217 217 / 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .goal-card__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .goal-card .goal-card__title {
    display: block;
    color: inherit;
    font-size: var(--goal-card-title-size, 1.625rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .goal-card__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--goal-card-icon, 36px);
    height: var(--goal-card-icon, 36px);
    border-radius: 50%;
    background-color: var(--goal-card-accent, #fbec00);
    color: var(--goal-card-accent-text, #1a1a1a);
    transition: transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .goal-card__icon svg {
    width: 20px;
    height: 20px;
  }

  .goal-card:not(.goal-card--disabled):hover .goal-card__icon {
    transform: rotate(45deg);
  }

  .goal-card:focus-visible {
    outline: 2px solid var(--goal-card-accent, #fbec00);
    outline-offset: 3px;
  }

  .goal-card--disabled {
    cursor: not-allowed;
  }

  .goal-card--disabled .goal-card__image {
    filter: grayscale(1);
  }

  .goal-card--disabled .goal-card__icon {
    background-color: var(--goal-card-disabled, #d0d0d0);
    color: var(--goal-card-disabled-text, #696969);
  }

  .goal-card .goal-card__status {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 8px;
    border-radius: 2px;
    background-color: var(--goal-card-disabled, #d0d0d0);
    color: var(--goal-card-disabled-text, #696969);
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .goal-card__image,
    .goal-card__icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.goal_card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "select",
      "id": "sample",
      "label": "t:settings.sample_image",
      "info": "t:info.sample_image_fallback",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "build-strength", "label": "t:options.build_strength" },
        { "value": "recover-faster", "label": "t:options.recover_faster" },
        { "value": "manage-weight", "label": "t:options.manage_weight" },
        { "value": "support-mobility", "label": "t:options.support_mobility" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Build"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:settings.sub_label",
      "default": "Strength"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.goal_card_link"
    }
  ]
}
{% endschema %}
