{% comment %}
  Section contract.
  Ascent footer: brand mark and tagline, up to four menu columns, a large wordmark,
  legal links and copyright.
  @example
  <!-- Add to the footer group; add Menu column blocks and pick a legal menu -->
{% endcomment %}
{% render 'ap-base' %}

{%- assign s = section.settings -%}
<footer class="ap-section ap-footer" style="--ap-footer-bg: {{ s.background }};">
  <div class="ap-footer__top">
    <div class="ap-footer__brand">
      {%- render 'ap-icon', name: 'mark', class: 'ap-footer__mark' -%}
      {%- if s.tagline != blank -%}
        <p class="ap-footer__tagline">{{ s.tagline | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>

    <div class="ap-footer__cols">
      {%- for block in section.blocks -%}
        {%- assign menu = block.settings.menu -%}
        <nav class="ap-footer__col" aria-label="{{ block.settings.heading | default: menu.title | escape }}" {{ block.shopify_attributes }}>
          <h2 class="ap-footer__head">{{ block.settings.heading | default: menu.title | escape }}</h2>
          {%- if menu.links.size > 0 -%}
            <ul class="ap-footer__links" role="list">
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </nav>
      {%- endfor -%}
    </div>
  </div>

  <div class="ap-footer__bottom">
    <a href="{{ routes.root_url }}" class="ap-footer__wordmark">
      {% render 'ap-image',
        image: s.wordmark,
        fallback: 'ap-footer-wordmark.webp',
        fallback_width: 1200,
        fallback_height: 331,
        alt: shop.name,
        sizes: '(min-width: 990px) 580px, 100vw',
        widths: '390, 580, 780, 1160'
      %}
    </a>
    <div class="ap-footer__legal">
      <p class="ap-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ s.copyright | default: shop.name | escape }}</p>
      {%- for link in s.legal_menu.links -%}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  html .ap-footer {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 56px 20px 36px;
    border-top: 1px solid var(--ap-line);
    background: var(--ap-footer-bg);
    color: var(--ap-white);
  }

  html .ap-footer__top {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  html .ap-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  html .ap-footer__mark {
    width: 32px;
    height: 41px;
    color: var(--ap-yellow);
  }

  html .ap-footer__tagline {
    margin: 0;
    font-family: var(--ap-font-display);
    font-weight: 700;
    font-size: 32px;
    line-height: 30px;
  }

  html .ap-footer__cols {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  html .ap-footer__col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  html .ap-footer__head {
    margin: 0;
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ap-grey-400);
  }

  html .ap-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  html .ap-footer__links a,
  html .ap-footer__legal a {
    color: var(--ap-grey-100);
    text-decoration: none;
    transition: color 0.2s;
  }

  html .ap-footer__links a {
    font-size: 16px;
    line-height: 22px;
  }

  html .ap-footer__links a:hover,
  html .ap-footer__legal a:hover {
    color: var(--ap-yellow);
  }

  html .ap-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  html .ap-footer__wordmark img {
    display: block;
    width: 100%;
    height: auto;
  }

  html .ap-footer__legal {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  html .ap-footer__copy {
    order: 1;
    margin: 0;
  }

  html .ap-footer__legal,
  html .ap-footer__legal a {
    font-family: var(--ap-font-mono);
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ap-grey-400);
  }

  @media screen and (min-width: 990px) {
    html .ap-footer {
      gap: 0;
      padding: 80px 48px 40px;
    }

    html .ap-footer__top {
      flex-direction: row;
      gap: 32px;
      padding-bottom: 56px;
    }

    html .ap-footer__brand {
      flex: 1 1 0;
      gap: 22px;
    }

    html .ap-footer__tagline {
      font-size: 26px;
      line-height: 26px;
    }

    html .ap-footer__cols {
      display: contents;
    }

    html .ap-footer__col {
      flex: 1 1 0;
      gap: 14px;
    }

    html .ap-footer__head {
      font-size: 14px;
      line-height: 20px;
    }

    html .ap-footer__links {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    html .ap-footer__bottom {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      padding-top: 36px;
      border-top: 1px solid var(--ap-line);
    }

    html .ap-footer__wordmark {
      flex: 0 1 580px;
    }

    html .ap-footer__legal {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 18px;
      padding-bottom: 12px;
    }

    html .ap-footer__legal,
    html .ap-footer__legal a {
      text-transform: none;
    }

    html .ap-footer__copy {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent footer",
  "class": "ap-footer-section",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Clean, honest nutrition.\nMade in Colorado." },
    { "type": "image_picker", "id": "wordmark", "label": "Wordmark image" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu" },
    { "type": "text", "id": "copyright", "label": "Copyright name", "default": "Ascent Protein" },
    { "type": "color", "id": "background", "label": "Background", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Ascent footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Learn" } },
        { "type": "menu", "settings": { "heading": "Support" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
