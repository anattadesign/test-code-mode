{% comment %}
  Section contract.
  Closing call-to-action band: eyebrow, large heading and one button, centred.
  @example
  <!-- Place near the end of the homepage -->
{% endcomment %}
{% render 'ap-base' %}

{%- assign s = section.settings -%}
<div class="ap-section ap-cta ap-pad" style="--ap-cta-bg: {{ s.background }};">
  <div class="ap-container ap-cta__inner">
    {%- if s.eyebrow != blank -%}
      <p class="ap-eyebrow ap-cta__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="ap-h2 ap-cta__title">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="ap-btn ap-btn--primary ap-cta__btn">
        {{- s.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  html .ap-cta {
    background: var(--ap-cta-bg);
    color: var(--ap-off-white);
  }

  html .ap-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  html .ap-cta__eyebrow {
    color: var(--ap-grey-400);
  }

  html .ap-cta__btn {
    align-self: center;
    min-height: 56px;
    min-width: 248px;
  }

  @media screen and (min-width: 990px) {
    html .ap-cta__inner {
      align-items: center;
      gap: 24px;
      text-align: center;
    }

    html .ap-cta__title {
      font-size: 64px;
      line-height: 61px;
      color: var(--ap-white);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent CTA band",
  "class": "ap-cta-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Whatever first place looks like for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Now go build something." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start with protein" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#1a1a1a" }
  ],
  "presets": [{ "name": "Ascent CTA band" }]
}
{% endschema %}
