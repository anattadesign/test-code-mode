{% comment %}
  Section contract.
  Bestseller rail: heading + intro, then a scrollable row of Ascent product cards.
  Each Product block picks a store product and adds merchandising (tag, badges, spec,
  dark or light card). With no blocks, the chosen collection fills the rail.
  @example
  <!-- Add Product blocks, or leave empty and pick a collection -->
{% endcomment %}
{% render 'ap-base' %}

{%- assign s = section.settings -%}
<div class="ap-section ap-best ap-pad" style="--ap-best-bg: {{ s.background }};">
  <div class="ap-container ap-best__head">
    {%- if s.heading != blank -%}
      <h2 class="ap-h2 ap-best__title">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <div class="ap-body ap-muted ap-best__text">{{ s.text }}</div>
    {%- endif -%}
  </div>

  <ap-rail-scroller class="ap-best__scroller">
    <div class="ap-rail ap-best__rail" data-rail>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {% render 'ap-product-card',
            product: b.product,
            style: b.card_style,
            tag: b.tag,
            spec: b.spec,
            badge_1: b.badge_1,
            badge_1_style: b.badge_1_style,
            badge_2: b.badge_2,
            badge_2_style: b.badge_2_style,
            rating: b.rating,
            rating_count: b.rating_count,
            button_label: s.button_label,
            attributes: block.shopify_attributes
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for product in s.collection.products limit: s.max_products -%}
          {%- liquid
            assign card_style = 'light'
            if forloop.first and s.first_dark
              assign card_style = 'dark'
            endif
          -%}
          {% render 'ap-product-card', product: product, style: card_style, button_label: s.button_label %}
        {%- else -%}
          {%- for i in (1..4) -%}
            {% render 'ap-product-card', product: blank, style: 'light', button_label: s.button_label %}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {% render 'ap-rail-nav', label: s.heading %}
  </ap-rail-scroller>
</div>

{% stylesheet %}
  html .ap-best {
    background: var(--ap-best-bg);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  html .ap-best__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  html .ap-best__text p {
    margin: 0;
  }

  html .ap-best__scroller {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  html .ap-best__rail {
    --ap-rail-gap: 12px;
    align-items: center;
    padding-block: 2px;
  }

  html .ap-best__rail > .ap-card {
    width: 300px;
  }

  @media screen and (min-width: 990px) {
    html .ap-best {
      gap: 48px;
    }

    html .ap-best__head {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
    }

    html .ap-best__text {
      max-width: 427px;
    }

    html .ap-best__scroller {
      gap: 48px;
    }

    html .ap-best__rail > .ap-card {
      width: 338px;
    }

    html .ap-best__rail {
      --ap-rail-gap: 24px;
      padding-inline-start: max(var(--ap-gutter), calc((100% - var(--ap-max)) / 2));
      scroll-padding-inline: max(var(--ap-gutter), calc((100% - var(--ap-max)) / 2));
    }

    html .ap-best .ap-rail-nav {
      width: 100%;
      max-width: calc(var(--ap-max) + var(--ap-gutter) * 2);
      margin-inline: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent bestsellers",
  "class": "ap-best-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Work. Replenish. Recover." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Four formulations built on native whey and creatine. Sourced, formulated, verified, no shortcuts, no compromises.</p>" },
    { "type": "text", "id": "button_label", "label": "Card button label", "default": "Shop now" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Without product blocks" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used when the section has no Product blocks." },
    { "type": "range", "id": "max_products", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "first_dark", "label": "Highlight first card in dark", "default": true }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "select",
          "id": "card_style",
          "label": "Card style",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Hydrate" },
        { "type": "text", "id": "spec", "label": "Spec line", "default": "5g creatine · 100% creapure" },
        { "type": "header", "content": "Badges" },
        { "type": "text", "id": "badge_1", "label": "Badge 1" },
        {
          "type": "select",
          "id": "badge_1_style",
          "label": "Badge 1 style",
          "options": [
            { "value": "yellow", "label": "Yellow" },
            { "value": "dark", "label": "Dark" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "yellow"
        },
        { "type": "text", "id": "badge_2", "label": "Badge 2" },
        {
          "type": "select",
          "id": "badge_2_style",
          "label": "Badge 2 style",
          "options": [
            { "value": "yellow", "label": "Yellow" },
            { "value": "dark", "label": "Dark" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "dark"
        },
        { "type": "header", "content": "Rating fallback", "info": "Shown when the product has no reviews.rating metafield." },
        { "type": "text", "id": "rating", "label": "Rating", "default": "4.7" },
        { "type": "text", "id": "rating_count", "label": "Review count", "default": "128" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Ascent bestsellers",
      "blocks": [
        { "type": "product", "settings": { "card_style": "dark", "tag": "Recover", "badge_1": "#1 Bestseller" } },
        { "type": "product", "settings": { "tag": "Hydrate", "badge_1": "New", "badge_1_style": "outline", "badge_2": "5M+ units sold" } },
        { "type": "product", "settings": { "tag": "Hydrate", "badge_1": "Informed Sport Certified", "badge_1_style": "outline", "badge_2": "5M+ units sold" } },
        { "type": "product", "settings": { "tag": "Hydrate", "badge_1": "Limited time flavours", "badge_1_style": "outline", "badge_2": "5M+ units sold" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
