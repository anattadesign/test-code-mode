{%- comment -%}
  Ascent #WhatMovesYou community carousel (WAK-34): full-bleed media strip (image/video blocks, portrait 3:4 or
  landscape 4:3) with the glass hashtag pill centred on top. Scroll/swipe; drag on desktop.
{%- endcomment -%}
{%- assign ss = section.settings -%}

<ascent-community
  class="ascent-community"
  style="
    --community-bg: {{ ss.background_color }};
    --community-accent: {{ ss.accent_color }};
    --community-pill-bg: {{ ss.pill_background | color_modify: 'alpha', 0.2 }};
    --community-gap: {{ ss.gap }}px;
    --community-padding: {{ ss.padding_block }}px;
    --community-padding-mobile: {{ ss.padding_block_mobile }}px;
  "
>
  <div
    class="ascent-community__rail"
    data-rail
    tabindex="0"
    role="region"
    aria-label="{{ ss.heading | escape }}"
  >
    {% content_for 'blocks' %}
  </div>

  {%- if ss.heading != blank -%}
    <div class="ascent-community__overlay">
      {%- if ss.link != blank -%}
        <a class="ascent-community__pill" href="{{ ss.link }}" {% if ss.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>
          <h2 class="ascent-community__heading display-xl">{{ ss.heading }}</h2>
        </a>
      {%- else -%}
        <div class="ascent-community__pill">
          <h2 class="ascent-community__heading display-xl">{{ ss.heading }}</h2>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</ascent-community>

<script src="{{ 'ascent-community.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .ascent-community {
    position: relative;
    display: block;
    padding-block: var(--community-padding);
    background-color: var(--community-bg);
  }

  .ascent-community__rail {
    --community-height: 420px;

    display: flex;
    gap: var(--community-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    cursor: grab;
  }

  .ascent-community__rail::-webkit-scrollbar {
    display: none;
  }

  .ascent-community__rail.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .ascent-community__rail:focus-visible {
    outline: 2px solid var(--community-accent);
    outline-offset: 4px;
  }

  .ascent-community__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-inline: 20px;
    pointer-events: none;
  }

  .ascent-community__pill {
    display: block;
    padding: 16px 24px;
    border: 2px solid var(--community-accent);
    border-radius: 999px;
    background-color: var(--community-pill-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--community-accent);
    text-decoration: none;
    pointer-events: auto;
  }

  .ascent-community .ascent-community__heading {
    margin: 0;
    color: var(--community-accent);
    font-size: 6.5rem;
    font-weight: 700;
    line-height: 0.913;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ascent-community {
      padding-block: var(--community-padding-mobile);
    }

    .ascent-community__rail {
      --community-height: 280px;
    }

    .ascent-community__pill {
      border: 0;
      border-radius: 32px;
      box-shadow: inset 0 0 0 1px var(--community-accent);
    }

    .ascent-community .ascent-community__heading {
      font-size: 2rem;
      line-height: 30px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ascent_community",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_community-media" }],
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "#WhatMovesYou"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.community_link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#fbec00"
    },
    {
      "type": "color",
      "id": "pill_background",
      "label": "t:settings.pill_background",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "t:settings.padding_block",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_block_mobile",
      "label": "t:settings.padding_block_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.ascent_community",
      "category": "t:categories.storytelling",
      "blocks": {
        "media_boxer": { "type": "_community-media", "settings": { "orientation": "portrait", "sample": "boxer", "alt": "Boxer taping hands" } },
        "media_chef": { "type": "_community-media", "settings": { "orientation": "landscape", "sample": "chef", "alt": "Chef during morning prep" } },
        "media_lifter": { "type": "_community-media", "settings": { "orientation": "portrait", "sample": "lifter", "alt": "Lifter mid-set" } },
        "media_kitchen": { "type": "_community-media", "settings": { "orientation": "landscape", "sample": "kitchen", "alt": "Preparing a shake in the kitchen" } },
        "media_runner": { "type": "_community-media", "settings": { "orientation": "portrait", "sample": "runner", "alt": "Trail runner with a shaker" } },
        "media_prep": { "type": "_community-media", "settings": { "orientation": "landscape", "sample": "prep", "alt": "Morning meal prep" } }
      },
      "block_order": ["media_boxer", "media_chef", "media_lifter", "media_kitchen", "media_runner", "media_prep"]
    }
  ]
}
{% endschema %}
