{% comment %}
  Section contract.
  Bundle / membership offer on a yellow panel: product imagery, pitch copy, an add-on
  callout, and a purchase card with subscribe vs one-time options. Prices come from
  the selected product; the subscribe price applies the configured discount.
  @example
  <!-- Pick the bundle product, set the subscription discount and benefits -->
{% endcomment %}
{% render 'ap-base' %}

{%- liquid
  assign s = section.settings
  assign product = s.product
  if product != blank
    assign one_time = product.price
    assign product_url = product.url
  else
    assign one_time = 6999
    assign product_url = routes.all_products_collection_url
  endif
  assign keep = 100 | minus: s.subscribe_discount
  assign subscribe = one_time | times: keep | divided_by: 100
  assign savings = one_time | minus: subscribe
  assign savings_money = savings | money_without_trailing_zeros
  assign plan_name = 'ap-plan-' | append: section.id
  assign per = s.price_suffix
-%}

<div class="ap-section ap-bundle" style="--ap-bundle-bg: {{ s.background }};">
  <div class="ap-bundle__inner">
    <div class="ap-bundle__visual" aria-hidden="true">
      <div class="ap-bundle__stack">
        {% render 'ap-image', image: s.image_1, fallback: 'ap-bundle-whey.webp', fallback_width: 1000, fallback_height: 1000, alt: '', class: 'ap-bundle__img-1', sizes: '472px', widths: '472, 944' %}
        {% render 'ap-image', image: s.image_2, fallback: 'ap-bundle-creatine.webp', fallback_width: 900, fallback_height: 900, alt: '', class: 'ap-bundle__img-2', sizes: '416px', widths: '416, 832' %}
      </div>
      <div class="ap-bundle__mobile-img">
        {% render 'ap-image', image: s.image_mobile, fallback: 'ap-bundle-mobile.webp', fallback_width: 800, fallback_height: 662, alt: '', sizes: '100vw', widths: '400, 700, 800' %}
      </div>
    </div>

    <div class="ap-bundle__card">
      <div class="ap-bundle__intro">
        <div class="ap-bundle__copy">
          {%- if s.eyebrow != blank -%}
            <p class="ap-eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="ap-h2">{{ s.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if s.text != blank -%}
          <div class="ap-body ap-muted">{{ s.text }}</div>
        {%- endif -%}

        {%- if s.addon_title != blank -%}
          <div class="ap-bundle__addon">
            <div class="ap-bundle__addon-img">
              {% render 'ap-image', image: s.addon_image, fallback: 'ap-bundle-addon.webp', fallback_width: 200, fallback_height: 332, alt: '', sizes: '88px', widths: '88, 176' %}
            </div>
            <div class="ap-bundle__addon-copy">
              <p class="ap-bundle__addon-title">{{ s.addon_title | escape }}</p>
              {%- if s.addon_text != blank -%}
                <p class="ap-bundle__addon-text">{{ s.addon_text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <span class="ap-bundle__divider" aria-hidden="true"></span>

      <div class="ap-bundle__buy">
        <fieldset class="ap-bundle__plans">
          <legend class="ap-visually-hidden">{{ s.heading | escape }}</legend>

          <label class="ap-plan ap-plan--subscribe">
            {%- if s.subscribe_chip != blank -%}
              <span class="ap-plan__chip">{{ s.subscribe_chip | escape }}</span>
            {%- endif -%}
            <span class="ap-plan__body">
              <span class="ap-plan__row">
                <input type="radio" name="{{ plan_name }}" value="subscribe" class="ap-plan__input" checked>
                <span class="ap-plan__radio" aria-hidden="true"></span>
                <span class="ap-plan__label">{{ s.subscribe_label | escape }}</span>
                <span class="ap-plan__prices">
                  <span class="ap-plan__price">{{ subscribe | money }}{{ per }}</span>
                  <s class="ap-plan__was">{{ one_time | money }}{{ per }}</s>
                </span>
              </span>
              {%- if section.blocks.size > 0 -%}
                <ul class="ap-plan__benefits" role="list">
                  {%- for block in section.blocks -%}
                    <li {{ block.shopify_attributes }}>
                      {%- render 'ap-icon', name: 'north-star' -%}
                      {{ block.settings.text | escape }}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </span>
          </label>

          <label class="ap-plan ap-plan--once">
            <span class="ap-plan__body">
              <span class="ap-plan__row">
                <input type="radio" name="{{ plan_name }}" value="once" class="ap-plan__input">
                <span class="ap-plan__radio" aria-hidden="true"></span>
                <span class="ap-plan__label">{{ s.once_label | escape }}</span>
                <span class="ap-plan__prices">
                  <span class="ap-plan__price">{{ one_time | money }}</span>
                </span>
              </span>
            </span>
          </label>
        </fieldset>

        <div class="ap-bundle__total">
          <p class="ap-bundle__total-prices">
            <s class="ap-bundle__total-was" data-plan="subscribe">{{ one_time | money }}</s>
            <span class="ap-bundle__total-now" data-plan="subscribe">{{ subscribe | money }}{{ per }}</span>
            <span class="ap-bundle__total-now" data-plan="once">{{ one_time | money }}</span>
          </p>
          {%- if savings > 0 and s.savings_label != blank -%}
            <span class="ap-badge ap-badge--yellow ap-bundle__savings" data-plan="subscribe">
              {{- s.savings_label | replace: '[amount]', savings_money -}}
            </span>
          {%- endif -%}
        </div>

        <a href="{{ product_url }}" class="ap-btn ap-btn--dark ap-btn--icon ap-bundle__cta">
          <span>{{ s.button_label | escape }}</span>
          <span class="ap-btn__icon">{% render 'ap-icon', name: 'arrow-up-right' %}</span>
        </a>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  html .ap-bundle {
    background: var(--ap-bundle-bg);
    color: var(--ap-ink);
  }

  html .ap-bundle__inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 1440px;
    margin-inline: auto;
    padding: 40px var(--ap-gutter) 48px;
  }

  html .ap-bundle__visual {
    order: 2;
  }

  html .ap-bundle__stack {
    display: none;
  }

  html .ap-bundle__mobile-img img {
    width: 100%;
    height: auto;
  }

  html .ap-bundle__card {
    display: contents;
  }

  html .ap-bundle__intro {
    order: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  html .ap-bundle__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  html .ap-bundle__copy .ap-eyebrow {
    color: var(--ap-grey-500);
  }

  html .ap-bundle__intro .ap-body p {
    margin: 0;
  }

  html .ap-bundle__addon,
  html .ap-bundle__divider,
  html .ap-bundle__plans {
    display: none;
  }

  html .ap-bundle__buy {
    order: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  html .ap-bundle__total {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  html .ap-bundle__total-prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
  }

  html .ap-bundle__total-now {
    order: 1;
    font-family: var(--ap-font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 26px;
  }

  html .ap-bundle__total-was {
    order: 2;
    font-family: var(--ap-font-display);
    font-weight: 700;
    font-size: 16px;
    line-height: 19px;
    color: var(--ap-grey-500);
  }

  html .ap-bundle__savings {
    background: transparent;
    border-color: var(--ap-ink);
  }

  html .ap-bundle [data-plan='once'] {
    display: none;
  }

  html .ap-bundle:has(.ap-plan__input[value='once']:checked) [data-plan='once'] {
    display: inline;
  }

  html .ap-bundle:has(.ap-plan__input[value='once']:checked) [data-plan='subscribe'] {
    display: none;
  }

  /* Plans */
  html .ap-plan {
    display: block;
    border: 1px solid var(--ap-grey-300);
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  html .ap-plan:has(.ap-plan__input:checked) {
    border: 1.5px solid var(--ap-ink);
  }

  html .ap-plan__chip {
    display: block;
    padding: 6px;
    border-radius: 2px;
    background: var(--ap-yellow);
    text-align: center;
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  html .ap-plan__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px;
  }

  html .ap-plan__row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  html .ap-plan__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  html .ap-plan__radio {
    flex: none;
    width: 16px;
    height: 16px;
    border: 1.2px solid var(--ap-ink);
    border-radius: 50%;
  }

  html .ap-plan__input:checked + .ap-plan__radio {
    background: radial-gradient(circle, var(--ap-ink) 0 4.5px, transparent 5px);
  }

  html .ap-plan__input:focus-visible + .ap-plan__radio {
    outline: 2px solid var(--ap-ink);
    outline-offset: 2px;
  }

  html .ap-plan__label {
    flex: 1;
    font-weight: 700;
    font-size: 14px;
    line-height: 21px;
  }

  html .ap-plan__prices {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  html .ap-plan__price {
    font-weight: 700;
    font-size: 14px;
    line-height: 21px;
  }

  html .ap-plan__was {
    font-family: var(--ap-font-mono);
    font-weight: 600;
    font-size: 14px;
    line-height: 14px;
    letter-spacing: 0.04em;
    color: var(--ap-grey-500);
    opacity: 0.7;
  }

  html .ap-plan__benefits {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 12px 0 0;
    border-top: 1px solid rgb(65 65 65 / 0.28);
    list-style: none;
  }

  html .ap-plan__benefits li {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    line-height: 21px;
    color: var(--ap-grey-500);
  }

  html .ap-plan__benefits .ap-icon {
    flex: none;
    color: var(--ap-ink);
  }

  @media screen and (min-width: 990px) {
    html .ap-bundle__inner {
      flex-direction: row;
      align-items: center;
      gap: 40px;
      padding: 56px;
    }

    html .ap-bundle__visual {
      order: 0;
      position: relative;
      flex: 0 0 auto;
      width: min(411px, 30vw);
      aspect-ratio: 1;
    }

    html .ap-bundle__mobile-img {
      display: none;
    }

    html .ap-bundle__stack {
      display: block;
      position: absolute;
      inset: 0;
    }

    html .ap-bundle__stack img {
      position: absolute;
      object-fit: contain;
      filter: drop-shadow(0 20px 30px rgb(0 0 0 / 0.12));
    }

    html .ap-bundle__img-1 {
      left: -29.2%;
      top: -17.8%;
      width: 114.8%;
      height: 135.8%;
    }

    html .ap-bundle__img-2 {
      left: 28.2%;
      top: 8.8%;
      width: 101.2%;
      height: 101%;
    }

    html .ap-bundle__card {
      position: relative;
      display: flex;
      flex: 1;
      gap: 44px;
      padding: 32px;
      border-radius: 8px;
      background: rgb(255 255 255 / 0.8);
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
    }

    html .ap-bundle__intro {
      flex: 1 1 390px;
      gap: 24px;
    }

    html .ap-bundle__copy {
      gap: 16px;
    }

    html .ap-bundle__copy .ap-eyebrow {
      font-size: 12px;
      line-height: 17px;
    }

    html .ap-bundle__addon {
      display: flex;
      align-items: center;
      gap: 28px;
      padding: 18px;
      border: 1.5px solid var(--ap-ink);
      border-radius: 4px;
    }

    html .ap-bundle__addon-img {
      flex: none;
      width: 88px;
      height: 88px;
    }

    html .ap-bundle__addon-img img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    html .ap-bundle__addon-copy {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    html .ap-bundle__addon-title {
      margin: 0;
      font-weight: 700;
      font-size: 20px;
      line-height: 26px;
    }

    html .ap-bundle__addon-text {
      margin: 0;
      font-size: 16px;
      line-height: 22px;
      color: var(--ap-grey-500);
    }

    html .ap-bundle__divider {
      display: block;
      flex: none;
      width: 1px;
      background: rgb(65 65 65 / 0.28);
    }

    html .ap-bundle__buy {
      flex: 0 1 334px;
      align-items: stretch;
      justify-content: space-between;
      gap: 24px;
    }

    html .ap-bundle__plans {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 0;
      padding: 0;
      border: 0;
    }

    html .ap-bundle__total {
      justify-content: space-between;
      gap: 24px;
    }

    html .ap-bundle__total-prices {
      gap: 6px;
    }

    html .ap-bundle__total-was {
      order: 0;
      font-family: var(--ap-font-body);
      font-weight: 400;
      font-size: 20px;
      line-height: 26px;
      opacity: 0.7;
    }

    html .ap-bundle__total-now {
      font-family: var(--ap-font-body);
      font-size: 20px;
      line-height: 26px;
    }

    html .ap-bundle__savings {
      background: var(--ap-yellow);
      border-color: transparent;
    }

    html .ap-bundle__cta {
      align-self: flex-start;
      min-width: 298px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent bundle offer",
  "class": "ap-bundle-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Bundle product" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fbec00" },
    { "type": "header", "content": "Imagery" },
    { "type": "image_picker", "id": "image_1", "label": "Back image (desktop)" },
    { "type": "image_picker", "id": "image_2", "label": "Front image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bundle and save 20%" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Save 20% when you bundle Creatine" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Get your whey and creatine delivered together and save up to $15 every month.</p>" },
    { "type": "header", "content": "Add-on (desktop)" },
    { "type": "image_picker", "id": "addon_image", "label": "Image" },
    { "type": "text", "id": "addon_title", "label": "Title", "default": "Get a free shaker with your stack" },
    { "type": "text", "id": "addon_text", "label": "Text", "default": "Our legendary shaker, free with every stack" },
    { "type": "header", "content": "Purchase options" },
    { "type": "range", "id": "subscribe_discount", "label": "Subscription discount", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 20 },
    { "type": "text", "id": "subscribe_chip", "label": "Subscription chip", "default": "Save 20%" },
    { "type": "text", "id": "subscribe_label", "label": "Subscription label", "default": "Subscribe & Save 15%" },
    { "type": "text", "id": "once_label", "label": "One-time label", "default": "One Time Purchase" },
    { "type": "text", "id": "price_suffix", "label": "Subscription price suffix", "default": "/mo" },
    { "type": "text", "id": "savings_label", "label": "Savings badge", "info": "Use [amount] for the saving.", "default": "[amount] savings" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Select your flavour" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Subscription benefit",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Free shipping, always" }]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Ascent bundle offer",
      "blocks": [
        { "type": "benefit", "settings": { "text": "15% off every bag of native whey" } },
        { "type": "benefit", "settings": { "text": "Free shipping, always" } },
        { "type": "benefit", "settings": { "text": "Skip, swap or cancel anytime" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
