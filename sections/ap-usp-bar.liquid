{% comment %}
  Section contract.
  Row of product promises (icon + short label) separated by dividers. Centred on
  desktop; loops as a marquee on small screens.
  @example
  <!-- Add one Promise block per claim; pick a built-in icon or upload one -->
{% endcomment %}
{% render 'ap-base' %}

{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- unless forloop.first -%}<span class="ap-usp__divider" aria-hidden="true"></span>{%- endunless -%}
    <div class="ap-usp__item" {{ block.shopify_attributes }}>
      <span class="ap-usp__icon" aria-hidden="true">
        {%- if block.settings.custom_icon != blank -%}
          {{ block.settings.custom_icon | image_url: width: 88 | image_tag: loading: 'lazy', alt: '' }}
        {%- else -%}
          {%- render 'ap-icon', name: block.settings.icon -%}
        {%- endif -%}
      </span>
      <span class="ap-usp__label">{{ block.settings.text | escape }}</span>
    </div>
  {%- endfor -%}
{%- endcapture -%}

<div class="ap-section ap-usp" style="--ap-usp-bg: {{ section.settings.background }};">
  <div class="ap-usp__static">{{ items }}</div>
  <div class="ap-marquee ap-usp__marquee" style="--ap-marquee-duration: {{ section.settings.speed }}s; --ap-marquee-gap: 32px;">
    <div class="ap-marquee__track">{{ items }}</div>
    <div class="ap-marquee__track" aria-hidden="true">{{ items }}</div>
  </div>
</div>

{% stylesheet %}
  html .ap-usp {
    background: var(--ap-usp-bg);
    color: var(--ap-ink);
    padding-block: 12px;
  }

  html .ap-usp__static {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding-inline: var(--ap-gutter);
  }

  html .ap-usp .ap-marquee__track {
    gap: 32px;
  }

  html .ap-usp__item {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: none;
  }

  html .ap-usp__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 100px;
    background: var(--ap-white);
  }

  html .ap-usp__icon svg,
  html .ap-usp__icon img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  html .ap-usp__label {
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  html .ap-usp__divider {
    display: none;
    flex: none;
    width: 1px;
    height: 40px;
    background: var(--ap-grey-100);
  }

  @media screen and (min-width: 1200px) {
    html .ap-usp__static {
      display: flex;
    }

    html .ap-usp__marquee {
      display: none;
    }

    html .ap-usp__divider {
      display: block;
    }

    html .ap-usp__item {
      gap: 8px;
    }

    html .ap-usp__icon {
      width: 54px;
      height: 54px;
    }

    html .ap-usp__icon svg,
    html .ap-usp__icon img {
      width: 44px;
      height: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent promises",
  "class": "ap-usp-section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "speed", "label": "Mobile scroll duration", "min": 10, "max": 60, "step": 2, "unit": "s", "default": 24 }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "usp-flavours", "label": "No artificial flavours" },
            { "value": "usp-certified", "label": "Certified shield" },
            { "value": "usp-tested", "label": "Lab flask" },
            { "value": "usp-gluten", "label": "Gluten free" },
            { "value": "mark", "label": "Ascent mark" }
          ],
          "default": "usp-flavours"
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Overrides the built-in icon." },
        { "type": "text", "id": "text", "label": "Text", "default": "Zero artificial flavours" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ascent promises",
      "blocks": [
        { "type": "promise", "settings": { "icon": "usp-flavours", "text": "Zero artificial flavours" } },
        { "type": "promise", "settings": { "icon": "usp-certified", "text": "Informed Sports certified" } },
        { "type": "promise", "settings": { "icon": "usp-tested", "text": "3rd party tested" } },
        { "type": "promise", "settings": { "icon": "usp-gluten", "text": "Gluten free" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
