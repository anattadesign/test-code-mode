{% comment %}
  Section contract.
  "Why Ascent" brand story over a full-bleed photo: eyebrow, product image, large
  heading and numbered glass cards. Cards sit in a grid on desktop and a swipe rail
  on mobile.
  @example
  <!-- Add Reason blocks; numbers are generated from block order -->
{% endcomment %}
{% render 'ap-base' %}

{%- assign s = section.settings -%}
<div class="ap-section ap-why" style="--ap-why-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};">
  <div class="ap-why__bg" aria-hidden="true">
    {% render 'ap-image',
      image: s.background_image,
      fallback: 'ap-about-bg.webp',
      fallback_width: 2400,
      fallback_height: 1800,
      alt: '',
      class: 'ap-img-cover',
      sizes: '100vw'
    %}
  </div>

  <div class="ap-why__inner">
    <div class="ap-why__head">
      {%- if s.show_product_image -%}
        <div class="ap-why__product">
          {% render 'ap-image',
            image: s.product_image,
            fallback: 'ap-about-product.webp',
            fallback_width: 400,
            fallback_height: 400,
            alt: '',
            sizes: '178px',
            widths: '178, 356'
          %}
        </div>
      {%- endif -%}
      <div class="ap-why__copy">
        {%- if s.eyebrow != blank -%}
          <p class="ap-eyebrow ap-why__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="ap-h2 ap-why__title">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="ap-btn ap-btn--outline ap-btn--icon ap-why__btn">
            <span>{{ s.button_label | escape }}</span>
            <span class="ap-btn__icon">{% render 'ap-icon', name: 'arrow-up-right' %}</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <ap-rail-scroller class="ap-why__scroller">
      <div class="ap-rail ap-why__cards" data-rail>
        {%- for block in section.blocks -%}
          <article class="ap-why__card ap-glass" {{ block.shopify_attributes }}>
            <span class="ap-why__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div class="ap-why__card-body">
              <h3 class="ap-h3 ap-why__card-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="ap-why__card-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'ap-rail-nav', label: s.heading %}
    </ap-rail-scroller>
  </div>
</div>

{% stylesheet %}
  html .ap-why {
    color: var(--ap-white);
    background: var(--ap-ink);
    padding-block: 48px;
  }

  html .ap-why__bg {
    position: absolute;
    inset: 0;
  }

  html .ap-why__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--ap-why-overlay));
  }

  html .ap-why__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1328px;
    margin-inline: auto;
  }

  html .ap-why__head {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-inline: var(--ap-gutter);
  }

  html .ap-why__product {
    display: none;
    flex: none;
    width: 178px;
    aspect-ratio: 1;
  }

  html .ap-why__product img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  html .ap-why__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  html .ap-why__eyebrow {
    color: var(--ap-white);
  }

  html .ap-why__title {
    font-size: 28px;
    line-height: 28px;
    letter-spacing: -0.02em;
  }

  html .ap-why__scroller {
    display: flex;
    flex-direction: column;
    gap: 8px;
    --ap-track: var(--ap-white);
    --ap-thumb: var(--ap-yellow);
  }

  html .ap-why .ap-rail-nav {
    color: var(--ap-white);
    padding-top: 8px;
  }

  html .ap-why__cards {
    --ap-rail-gap: 12px;
    padding-block: 8px;
  }

  html .ap-why__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    width: 322px;
    min-height: 320px;
    padding: 24px 16px;
    border: 1px solid transparent;
    border-radius: 24px;
    transition: border-color 0.25s;
  }

  html .ap-why__num {
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.1em;
    color: var(--ap-yellow);
  }

  html .ap-why__card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  html .ap-why__card-title {
    font-size: 24px;
    line-height: 29px;
    letter-spacing: -0.04em;
  }

  html .ap-why__card-text {
    margin: 0;
    font-size: 14px;
    line-height: 21px;
    color: var(--ap-grey-100);
  }

  @media screen and (min-width: 990px) {
    html .ap-why {
      padding: 64px 56px;
    }

    html .ap-why__inner {
      gap: 32px;
      padding: 44px;
      border-radius: 6px;
    }

    html .ap-why__head {
      padding-inline: 0;
    }

    html .ap-why__product {
      display: block;
    }

    html .ap-why__copy {
      gap: 10px;
    }

    html .ap-why__eyebrow {
      font-weight: 600;
      font-size: 12px;
      line-height: 16px;
      letter-spacing: 0.06em;
      color: var(--ap-off-white);
    }

    html .ap-why__title {
      font-size: 64px;
      line-height: 61px;
      letter-spacing: 0;
    }

    html .ap-why__btn {
      display: none;
    }

    html .ap-why__cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      padding: 0;
      overflow: visible;
    }

    html .ap-why .ap-rail-nav {
      display: none;
    }

    html .ap-why__card {
      width: auto;
      min-height: 386px;
      padding: 32px;
      border-radius: 12px;
    }

    html .ap-why__num {
      font-family: var(--ap-font-display);
      font-weight: 400;
      font-size: 64px;
      line-height: 61px;
      letter-spacing: 0;
      color: var(--ap-off-white);
    }

    html .ap-why__cards:not(:hover) .ap-why__card:first-child,
    html .ap-why__card:hover {
      border-color: var(--ap-yellow);
    }

    html .ap-why__cards:not(:hover) .ap-why__card:first-child .ap-why__num,
    html .ap-why__card:hover .ap-why__num {
      font-weight: 700;
    }

    html .ap-why__card-title {
      font-size: 26px;
      line-height: 26px;
      letter-spacing: 0;
    }

    html .ap-why__card-text {
      font-size: 16px;
      line-height: 22px;
      color: var(--ap-off-white);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent why us",
  "class": "ap-why-section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 65 },
    { "type": "checkbox", "id": "show_product_image", "label": "Show product image (desktop)", "default": true },
    { "type": "image_picker", "id": "product_image", "label": "Product image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Ascent" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The cleanest protein we know how to make." },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Shown on mobile only.", "default": "Shop protein" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Minimal ingredients, minimal processing" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Five ingredients. Filtered cold from fresh milk, one pass, never cooked." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Ascent why us",
      "blocks": [
        { "type": "reason", "settings": { "title": "Minimal ingredients, minimal processing", "text": "Five ingredients. Filtered cold from fresh milk, one pass, never cooked." } },
        { "type": "reason", "settings": { "title": "Rigorous third-party testing", "text": "Informed Sport Certified. An outside lab checks every batch before it ships." } },
        { "type": "reason", "settings": { "title": "Tastes just like real milk", "text": "There's nothing artificial masking it, so it tastes like exactly what it's made from." } },
        { "type": "reason", "settings": { "title": "Gentle on your stomach", "text": "Most of the lactose is filtered out on the way. Sits light, mixes clean." } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
