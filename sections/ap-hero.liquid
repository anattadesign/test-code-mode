{% comment %}
  Section contract.
  Ascent homepage hero: full-bleed image with a dark scrim, headline, primary and
  secondary calls to action, and a review proof line. Separate desktop and mobile media.
  @example
  <!-- Place first on the homepage so the transparent header sits over it -->
{% endcomment %}
{% render 'ap-base' %}

{%- liquid
  assign s = section.settings
  assign eager = false
  if section.index <= 2
    assign eager = true
  endif
-%}

<div
  class="ap-section ap-hero"
  style="--ap-hero-h: {{ s.height_desktop }}px; --ap-hero-h-mobile: {{ s.height_mobile }}px; --ap-hero-scrim: {{ s.scrim_opacity | divided_by: 100.0 }};"
>
  <div class="ap-hero__media" aria-hidden="true">
    <picture>
      {%- if s.image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
      {%- elsif s.image_desktop == blank -%}
        <source media="(max-width: 749px)" srcset="{{ 'ap-hero-mobile.webp' | asset_url }}">
      {%- endif -%}
      {% render 'ap-image',
        image: s.image_desktop,
        fallback: 'ap-hero-desktop.webp',
        fallback_width: 2400,
        fallback_height: 1325,
        alt: '',
        class: 'ap-img-cover ap-hero__img',
        sizes: '100vw',
        eager: eager
      %}
    </picture>
    <span class="ap-hero__scrim"></span>
  </div>

  <div class="ap-container ap-hero__content">
    <div class="ap-hero__main">
      {%- if s.heading != blank -%}
        <h1 class="ap-h1 ap-hero__title">{{ s.heading | escape | newline_to_br }}</h1>
      {%- endif -%}
      <div class="ap-hero__ctas">
        {%- if s.primary_label != blank -%}
          <a href="{{ s.primary_link | default: routes.all_products_collection_url }}" class="ap-btn ap-btn--primary ap-btn--icon ap-hero__primary">
            <span>{{ s.primary_label | escape }}</span>
            <span class="ap-btn__icon">{% render 'ap-icon', name: 'arrow-up-right' %}</span>
          </a>
        {%- endif -%}
        {%- if s.secondary_label != blank -%}
          <a href="{{ s.secondary_link | default: '#' }}" class="ap-link ap-hero__secondary">
            <span>{{ s.secondary_label | escape }}</span>
            {% render 'ap-icon', name: 'arrow-up-right' %}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if s.rating_label != blank or s.rating_stars != blank -%}
      <div class="ap-hero__proof">
        {%- if s.rating_stars != blank -%}
          <span class="ap-hero__stars" aria-hidden="true">{{ s.rating_stars | escape }}</span>
        {%- endif -%}
        {%- if s.rating_label != blank -%}
          <span class="ap-hero__proof-label">{{ s.rating_label | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  html .ap-hero {
    display: flex;
    min-height: var(--ap-hero-h-mobile);
    color: var(--ap-white);
    background: var(--ap-ink);
  }

  html .ap-hero__media {
    position: absolute;
    inset: 0;
  }

  html .ap-hero__img {
    object-position: center top;
  }

  html .ap-hero__scrim {
    position: absolute;
    inset: 0;
    opacity: var(--ap-hero-scrim);
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 0%, rgb(0 0 0 / 0) 34%, rgb(0 0 0 / 0.72) 100%);
  }

  html .ap-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 44px;
    padding-block: 120px 40px;
  }

  html .ap-hero__main {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 473px;
  }

  html .ap-hero__title {
    font-weight: 900;
    color: inherit;
  }

  html .ap-hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  html .ap-hero__primary {
    width: 100%;
  }

  html .ap-hero__secondary {
    color: var(--ap-white);
  }

  html .ap-hero__secondary .ap-icon {
    width: 16px;
    height: 16px;
  }

  html .ap-hero__proof {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--ap-grey-100);
  }

  html .ap-hero__stars {
    font-family: var(--ap-font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 20px;
  }

  html .ap-hero__proof-label {
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    html .ap-hero__scrim {
      background: linear-gradient(90deg, rgb(40 40 40 / 1) 0%, rgb(40 40 40 / 0) min(733px, 60%));
    }

    html .ap-hero__primary {
      width: auto;
      min-width: 265px;
    }

    html .ap-hero__ctas {
      flex-direction: row;
      align-items: center;
      gap: 24px;
      padding-top: 4px;
    }
  }

  @media screen and (min-width: 990px) {
    html .ap-hero {
      min-height: var(--ap-hero-h);
    }

    html .ap-hero__content {
      gap: 120px;
      padding-block: 140px 20px;
    }

    html .ap-hero__main {
      gap: 24px;
    }

    html .ap-hero__title {
      font-weight: 700;
    }

    html .ap-hero__proof {
      gap: 16px;
      padding-inline-start: 14px;
    }

    html .ap-hero__stars {
      font-size: 26px;
      line-height: 26px;
      letter-spacing: -0.02em;
    }

    html .ap-hero__proof-label {
      font-size: 14px;
      line-height: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent hero",
  "class": "ap-hero-section",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image", "info": "Leave empty to use the design image." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "range", "id": "scrim_opacity", "label": "Scrim opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 480, "max": 960, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 480, "max": 900, "step": 20, "unit": "px", "default": 680 },
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Cleanest fuel for\nwhat moves you!" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop protein" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "See the science" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Review proof" },
    { "type": "text", "id": "rating_stars", "label": "Stars", "default": "★★★★★" },
    { "type": "text", "id": "rating_label", "label": "Label", "default": "6,000+ five star reviews" }
  ],
  "presets": [{ "name": "Ascent hero" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
