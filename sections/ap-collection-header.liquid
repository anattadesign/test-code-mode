{%- comment -%}
  AP-61 · Collection header (Ascent PLP page head).

  Figma: 02 / Page head — desktop 1906:24317 (1440 × 240) · mobile 1906:22824 (390 × 195).

  Banner image (or the collection image) under a charcoal scrim; breadcrumbs and
  the collection title sit on the left edge (64px desktop / 20px mobile),
  vertically centred on desktop and top-anchored (50px) on mobile, 16 / 12px apart.

  Content is theme blocks so merchants can reword the title (e.g. "Labor Day Sale"),
  add a short promo line or terms text, or reorder: breadcrumbs (ap-breadcrumbs),
  title / copy (text), buttons, or any @theme / @app block.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign image = s.image
  if image == blank and s.use_collection_image
    assign image = collection.image
  endif
  assign image_mobile = s.image_mobile | default: image
  unless s.show_image_mobile
    assign image_mobile = blank
  endunless

  assign loading = 'lazy'
  assign fetch_priority = 'auto'
  if section.index <= 2
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif

  assign scrim_alpha = s.scrim_opacity | divided_by: 100.0
  assign scrim = s.scrim_color | color_modify: 'alpha', scrim_alpha
-%}

<div
  class="ap-collection-header{% if image != blank %} ap-collection-header--has-image{% endif %}{% if image_mobile != blank %} ap-collection-header--has-image-mobile{% endif %}"
  style="
    --ap-ch-height: {{ s.height }}px;
    --ap-ch-height-mobile: {{ s.height_mobile }}px;
    --ap-ch-pad-inline: {{ s.padding_inline }}px;
    --ap-ch-pad-inline-mobile: {{ s.padding_inline_mobile }}px;
    --ap-ch-pad-block: {{ s.padding_block }}px;
    --ap-ch-pad-block-mobile: {{ s.padding_block_mobile }}px;
    --ap-ch-gap: {{ s.gap }}px;
    --ap-ch-gap-mobile: {{ s.gap_mobile }}px;
    --ap-ch-align: {{ s.content_vertical }};
    --ap-ch-align-mobile: {{ s.content_vertical_mobile }};
    --ap-ch-text: {{ s.text_color }};
    --ap-ch-bg: {{ s.background_color }};
    --ap-ch-scrim: {{ scrim }};
  "
>
  {%- if image != blank -%}
    <div class="ap-collection-header__media ap-collection-header__media--desktop">
      {{
        image
        | image_url: width: 3000
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2560, 3000',
          sizes: '100vw',
          loading: loading,
          fetchpriority: fetch_priority,
          alt: image.alt | default: '',
          style: s.image_position
      }}
    </div>
  {%- endif -%}
  {%- if image_mobile != blank -%}
    <div class="ap-collection-header__media ap-collection-header__media--mobile">
      {{
        image_mobile
        | image_url: width: 1200
        | image_tag:
          widths: '390, 600, 780, 1000, 1200',
          sizes: '100vw',
          loading: loading,
          fetchpriority: fetch_priority,
          alt: image_mobile.alt | default: ''
      }}
    </div>
  {%- endif -%}
  {%- if image != blank or image_mobile != blank -%}
    <div class="ap-collection-header__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="ap-collection-header__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .ap-collection-header {
    position: relative;
    display: flex;
    align-items: var(--ap-ch-align-mobile, flex-start);
    min-block-size: var(--ap-ch-height-mobile);
    padding: var(--ap-ch-pad-block-mobile) var(--ap-ch-pad-inline-mobile);
    overflow: hidden;
    background: var(--ap-ch-bg);
    color: var(--ap-ch-text);
    isolation: isolate;
  }

  .ap-collection-header__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .ap-collection-header__media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .ap-collection-header__media--desktop {
    display: none;
  }

  .ap-collection-header__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ap-ch-scrim);
  }

  .ap-collection-header:not(.ap-collection-header--has-image-mobile) .ap-collection-header__scrim {
    display: none;
  }

  .ap-collection-header__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ap-ch-gap-mobile);
    inline-size: 100%;
    max-inline-size: var(--page-width, 90rem);
    margin-inline: auto;
    --color: var(--ap-ch-text);
    color: var(--ap-ch-text);
  }

  .ap-collection-header__content > * {
    margin: 0;
  }

  .ap-collection-header__content :is(h1, h2, h3, p) {
    margin: 0;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .ap-collection-header {
      align-items: var(--ap-ch-align, center);
      min-block-size: var(--ap-ch-height);
      padding: var(--ap-ch-pad-block) var(--ap-ch-pad-inline);
    }

    .ap-collection-header__media--desktop {
      display: block;
    }

    .ap-collection-header__media--mobile {
      display: none;
    }

    .ap-collection-header__scrim {
      display: none;
    }

    .ap-collection-header--has-image .ap-collection-header__scrim {
      display: block;
    }

    .ap-collection-header__content {
      gap: var(--ap-ch-gap);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection header",
  "tag": "section",
  "class": "section-ap-collection-header",
  "enabled_on": {
    "templates": ["collection", "list-collections", "search", "page"]
  },
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header", "content": "Media" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image",
      "info": "Leave empty to use the collection image. 1440 × 240 or larger."
    },
    {
      "type": "checkbox",
      "id": "use_collection_image",
      "label": "Fall back to collection image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile banner image",
      "info": "Leave empty to use the banner image."
    },
    {
      "type": "checkbox",
      "id": "show_image_mobile",
      "label": "Show image on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point (desktop)",
      "options": [
        { "value": "object-position: center center;", "label": "Center" },
        { "value": "object-position: center top;", "label": "Top" },
        { "value": "object-position: center bottom;", "label": "Bottom" }
      ],
      "default": "object-position: center center;"
    },
    { "type": "header", "content": "Colours" },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Shown behind the image, or on its own when there is no image.",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Scrim",
      "default": "#1A1A1A"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "Scrim opacity",
      "info": "Keep at 60% or more when text sits on the image (brand rule).",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    { "type": "header", "content": "Layout — desktop" },
    {
      "type": "range",
      "id": "height",
      "label": "Minimum height",
      "min": 120,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Content position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Side padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Top and bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between blocks",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    { "type": "header", "content": "Layout — mobile" },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Minimum height",
      "min": 100,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 195
    },
    {
      "type": "select",
      "id": "content_vertical_mobile",
      "label": "Content position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "padding_inline_mobile",
      "label": "Side padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_block_mobile",
      "label": "Top and bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between blocks",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Collection header",
      "category": "Collection",
      "blocks": {
        "breadcrumbs": {
          "type": "ap-breadcrumbs",
          "settings": {
            "home_label": "Home",
            "collections_label": "Collections",
            "uppercase": true
          }
        },
        "title": {
          "type": "text",
          "settings": {
            "text": "<h1>{{ closest.collection.title }}</h1>",
            "type_preset": "h2",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["breadcrumbs", "title"]
    }
  ]
}
{% endschema %}
