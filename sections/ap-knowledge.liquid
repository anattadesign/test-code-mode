{% comment %}
  Section contract.
  Knowledge center: heading, article search, topic tabs and a rail of editorial cards.
  Article blocks can pull an article (image, title, excerpt, link) or use their own
  content; Topic blocks become tabs that filter cards by matching topic.
  @example
  <!-- Add Topic blocks for tabs and Article blocks tagged with the same topic -->
{% endcomment %}
{% render 'ap-base' %}

{%- assign s = section.settings -%}
{%- assign tabs = section.blocks | where: 'type', 'topic' -%}
{%- assign cards = section.blocks | where: 'type', 'article' -%}

<ap-filter-tabs class="ap-section ap-know ap-pad" style="--ap-know-bg: {{ s.background }};">
  <div class="ap-container ap-know__head">
    <div class="ap-know__title">
      {%- if s.eyebrow != blank -%}
        <p class="ap-eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="ap-h2">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if s.show_search -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="ap-know__search">
        <input type="hidden" name="type" value="article">
        <label for="ApKnowSearch-{{ section.id }}" class="ap-visually-hidden">{{ s.search_placeholder | escape }}</label>
        <span class="ap-know__search-icon" aria-hidden="true">{% render 'ap-icon', name: 'search-arrow' %}</span>
        <input
          id="ApKnowSearch-{{ section.id }}"
          type="search"
          name="q"
          class="ap-know__search-input"
          placeholder="{{ s.search_placeholder | escape }}"
          autocomplete="off"
        >
        <button type="submit" class="ap-btn ap-btn--primary ap-know__search-btn">{{ s.search_button | escape }}</button>
      </form>
    {%- endif -%}
  </div>

  {%- if tabs.size > 0 -%}
    <div class="ap-know__tabs" role="group" aria-label="{{ s.heading | escape }}">
      {%- for tab in tabs -%}
        {%- assign topic = tab.settings.topic | default: tab.settings.label | handleize -%}
        <button
          type="button"
          class="ap-know__tab"
          data-filter-tab="{{ topic }}"
          aria-pressed="{% if forloop.first and s.filter_first %}true{% else %}false{% endif %}"
          {{ tab.shopify_attributes }}
        >
          {{ tab.settings.label | escape }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <ap-rail-scroller class="ap-know__scroller">
    <div class="ap-rail ap-know__rail" data-rail>
      {%- liquid
        assign first_topic = ''
        if s.filter_first and tabs.size > 0
          assign first_topic = tabs.first.settings.topic | default: tabs.first.settings.label | handleize
        endif
      -%}
      {%- for block in cards -%}
        {%- liquid
          assign b = block.settings
          assign article = b.article
          assign title = b.title | default: article.title
          assign text = b.text
          if text == blank and article != blank
            assign text = article.excerpt_or_content | strip_html | truncatewords: 18
          endif
          assign link = b.link | default: article.url | default: '#'
          assign image = b.image | default: article.image
          assign topics = b.topic | split: ','
          assign topic_list = ''
          for t in topics
            assign handle = t | strip | handleize
            assign topic_list = topic_list | append: handle | append: ','
          endfor
          assign hidden = false
          if first_topic != blank
            unless topic_list contains first_topic
              assign hidden = true
            endunless
          endif
        -%}
        <a
          href="{{ link }}"
          class="ap-article ap-article--{{ b.size }}"
          data-topic="{{ topic_list }}"
          {% if hidden %}hidden{% endif %}
          {{ block.shopify_attributes }}
        >
          {% render 'ap-image',
            image: image,
            fallback: b.fallback,
            fallback_width: 1300,
            fallback_height: 866,
            alt: '',
            class: 'ap-img-cover ap-article__img',
            sizes: '(min-width: 990px) 650px, 320px',
            widths: '320, 480, 650, 960, 1300'
          %}
          <span class="ap-article__panel">
            {%- if b.badge != blank -%}
              <span class="ap-badge ap-badge--yellow">{{ b.badge | escape }}</span>
            {%- endif -%}
            <span class="ap-h3 ap-article__title">{{ title | escape }}</span>
            {%- if text != blank -%}
              <span class="ap-article__text">{{ text | escape }}</span>
            {%- endif -%}
            {%- if b.link_label != blank -%}
              <span class="ap-link ap-article__more">
                {{- b.link_label | escape -}}
                {%- render 'ap-icon', name: 'arrow-up-right' -%}
              </span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
    {% render 'ap-rail-nav', label: s.heading %}
  </ap-rail-scroller>
</ap-filter-tabs>

{% stylesheet %}
  html .ap-know {
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--ap-know-bg);
  }

  html .ap-know__head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  html .ap-know__title {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  html .ap-know__search {
    display: flex;
    align-items: center;
    height: 40px;
    border: 1px solid var(--ap-grey-100);
    border-radius: 999px;
  }

  html .ap-know__search:focus-within {
    border-color: var(--ap-ink);
  }

  html .ap-know__search-icon {
    display: grid;
    place-items: center;
    padding-inline: 16px 4px;
    color: var(--ap-grey-500);
  }

  html .ap-know__search-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0 8px 0 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 14px;
    line-height: 21px;
    color: var(--ap-ink);
    outline: none;
  }

  html .ap-know__search-input::placeholder {
    color: var(--ap-grey-500);
  }

  html .ap-know__search-btn {
    min-height: 40px;
    padding-inline: 16px;
    font-size: 14px;
  }

  html .ap-know__tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-inline: var(--ap-gutter);
    scrollbar-width: none;
  }

  html .ap-know__tab {
    flex: none;
    padding: 10px 16px;
    border: 1px solid var(--ap-grey-100);
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-weight: 700;
    font-size: 14px;
    line-height: 21px;
    color: var(--ap-ink);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }

  html .ap-know__tab:hover {
    border-color: var(--ap-ink);
  }

  html .ap-know__tab[aria-pressed='true'] {
    background: var(--ap-yellow);
    border-color: var(--ap-yellow);
  }

  html .ap-know__scroller {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  html .ap-know__rail {
    --ap-rail-gap: 12px;
  }

  html .ap-know .ap-rail-nav {
    --ap-track: rgb(140 140 140 / 0.2);
    --ap-thumb: var(--ap-ink);
  }

  html .ap-article {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 267px;
    height: 400px;
    border-radius: 8px;
    overflow: hidden;
    color: var(--ap-white);
    text-decoration: none;
    isolation: isolate;
  }

  html .ap-article[hidden] {
    display: none;
  }

  html .ap-article--featured {
    width: 320px;
  }

  html .ap-article__img {
    z-index: -1;
    transition: transform 0.6s var(--ap-ease);
  }

  html .ap-article:hover .ap-article__img {
    transform: scale(1.04);
  }

  html .ap-article__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 12px;
    background: rgb(0 0 0 / 0.27);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  html .ap-article--featured .ap-article__panel {
    padding-inline: 16px;
  }

  html .ap-article__title {
    font-size: 22px;
    line-height: 24px;
  }

  html .ap-article__text {
    font-size: 14px;
    line-height: 21px;
    color: var(--ap-off-white);
  }

  html .ap-article__more {
    color: var(--ap-yellow);
    font-size: 14px;
  }

  @media screen and (min-width: 990px) {
    html .ap-know {
      gap: 36px;
    }

    html .ap-know__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 64px;
    }

    html .ap-know__title {
      gap: 12px;
    }

    html .ap-know__search {
      flex: 0 1 460px;
      height: 48px;
    }

    html .ap-know__search-icon {
      padding-inline: 20px 8px;
    }

    html .ap-know__search-input {
      font-size: 16px;
      line-height: 22px;
    }

    html .ap-know__search-btn {
      min-height: 48px;
      padding-inline: 24px;
      font-size: 16px;
    }

    html .ap-know__tabs {
      gap: 12px;
      width: 100%;
      max-width: calc(var(--ap-max) + var(--ap-gutter) * 2);
      margin-inline: auto;
    }

    html .ap-know__tab {
      padding: 12px 24px;
      font-size: 16px;
      line-height: 22px;
    }

    html .ap-know__scroller {
      gap: 36px;
    }

    html .ap-know__rail {
      --ap-rail-gap: 24px;
      padding-inline-start: max(var(--ap-gutter), calc((100% - var(--ap-max)) / 2));
    }

    html .ap-know .ap-rail-nav {
      width: 100%;
      max-width: calc(var(--ap-max) + var(--ap-gutter) * 2);
      margin-inline: auto;
    }

    html .ap-article {
      width: 386px;
      height: 520px;
    }

    html .ap-article--featured {
      width: 650px;
    }

    html .ap-article__panel {
      padding: 24px 16px;
    }

    html .ap-article--featured .ap-article__panel {
      padding: 28px 24px;
    }

    html .ap-article__title {
      font-size: 26px;
      line-height: 26px;
    }

    html .ap-article__text {
      font-size: 16px;
      line-height: 22px;
    }

    html .ap-article__more {
      font-size: 16px;
      line-height: 19px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent knowledge center",
  "class": "ap-know-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Knowledge center" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Science Behind Your Fuel." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "checkbox", "id": "show_search", "label": "Show article search", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search ingredients, guides, myths…" },
    { "type": "text", "id": "search_button", "label": "Search button", "default": "Search" },
    { "type": "checkbox", "id": "filter_first", "label": "Filter by first topic on load", "info": "Off shows every article until a topic is chosen.", "default": true }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Protein" },
        { "type": "text", "id": "topic", "label": "Topic handle", "info": "Defaults to the label. Articles with this topic show under the tab." }
      ]
    },
    {
      "type": "article",
      "name": "Article",
      "settings": [
        { "type": "article", "id": "article", "label": "Article", "info": "Fills image, title, excerpt and link unless overridden below." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback",
          "label": "Design image (when no image)",
          "options": [
            { "value": "ap-article-1.webp", "label": "Image 1" },
            { "value": "ap-article-2.webp", "label": "Image 2" },
            { "value": "ap-article-3.webp", "label": "Image 3" },
            { "value": "ap-article-4.webp", "label": "Image 4" }
          ],
          "default": "ap-article-1.webp"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Card size",
          "options": [
            { "value": "regular", "label": "Regular" },
            { "value": "featured", "label": "Featured (wide)" }
          ],
          "default": "regular"
        },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Read more" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "topic", "label": "Topics", "info": "Comma-separated topic handles, e.g. protein, recovery." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Ascent knowledge center",
      "blocks": [
        { "type": "topic", "settings": { "label": "Protein" } },
        { "type": "topic", "settings": { "label": "Creatine" } },
        { "type": "topic", "settings": { "label": "Hydration" } },
        { "type": "topic", "settings": { "label": "Recovery" } },
        { "type": "article", "settings": { "fallback": "ap-article-1.webp", "size": "featured", "badge": "Featured", "title": "What is Native Whey?", "text": "Native whey is the least-processed whey protein available.", "link_label": "Read the guide", "topic": "protein" } },
        { "type": "article", "settings": { "fallback": "ap-article-2.webp", "title": "The recovery trigger", "text": "2.6g per serving crosses the threshold that tells your muscles to rebuild. Miss it and repair stalls.", "topic": "recovery, protein" } },
        { "type": "article", "settings": { "fallback": "ap-article-3.webp", "title": "The purest creatine", "text": "German-made monohydrate under stricter quality control. 5g per serving, unflavoured.", "topic": "creatine, protein" } },
        { "type": "article", "settings": { "fallback": "ap-article-4.webp", "title": "Tested every batch", "text": "Not a sample — every batch is screened by a third-party lab before it earns a label.", "topic": "hydration, protein" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
