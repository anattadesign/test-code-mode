

{% liquid
  assign max_items = section.settings.max_products
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    {% if section.settings.card_style == 'ascent' %}section-resource-list--ascent{% if section.settings.highlight_first %} section-resource-list--highlight-first{% endif %}{% endif %}
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
    {%- if section.settings.card_style == 'ascent' %}
      --ascent-slide-width: {{ section.settings.slide_width }}px;
      --ascent-padding-block-start-mobile: {{ section.settings['padding-block-start'] | times: 0.6 | round }}px;
      --ascent-padding-block-end-mobile: {{ section.settings['padding-block-end'] | times: 0.6 | round }}px;
      --ascent-gap-mobile: {{ section.settings.gap | times: 0.5 | round }}px;
      --ascent-slide-width-mobile: {{ section.settings.slide_width_mobile }}px;
      --ascent-text: {{ section.settings.text_color }};
      --ascent-muted: {{ section.settings.muted_color }};
      --ascent-surface: {{ section.settings.background_color | default: settings.color_palette.background }};
      --ascent-highlight-bg: {{ section.settings.highlight_background }};
      --ascent-highlight-text: {{ section.settings.highlight_text }};
      --ascent-highlight-muted: {{ section.settings.highlight_muted }};
    {%- endif %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by max_items %}
        {% for product in section.settings.collection.products limit: max_items %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product,
              product_view_context: 'collection'
            %}
          </div>

          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  /* Ascent card style (WAK-26): fixed-width cards that bleed off the right edge, centred content,
     metafield badges over the image, and a desktop hover state that grows the card and reveals the description. */
  .section-resource-list--ascent {
    --ascent-hover-grow: 27px;
  }

  .section-resource-list--ascent .resource-list__carousel .resource-list__slide {
    --slide-width: var(--ascent-slide-width);
  }

  .section-resource-list--ascent .resource-list__carousel > slideshow-container > slideshow-slides {
    margin-block: -32px;
    padding-block: 32px;
  }

  .section-resource-list--ascent .product-grid__card.product-grid__card {
    position: relative;
    align-items: center;
    text-align: center;
    color: var(--ascent-text);
  }

  .section-resource-list--ascent .resource-list__slide {
    transition: margin-block 0.3s var(--ease-out-quad, ease);
  }

  .section-resource-list--ascent quick-add-component {
    display: none;
  }

  .section-resource-list--ascent .product-grid__card .card-gallery {
    width: 100%;
    margin-block-end: calc(-1 * var(--product-card-gap));
  }

  .section-resource-list--ascent .product-card-button {
    margin-block-start: auto;
    padding-block-start: 4px;
  }

  .section-resource-list--ascent .product-meta--badges {
    position: absolute;
    inset-block-start: 12px;
    inset-inline: 8px;
    width: auto;
    z-index: 2;
  }

  /* Header intro sits in a 27rem column on the right (Figma 427px) */
  @media screen and (min-width: 750px) {
    .section-resource-list--ascent .section-resource-list__header .text-block + .text-block {
      flex: 0 1 27rem;
    }

    /* Reserve room for the hover growth so it never touches the header */
    .section-resource-list--ascent .resource-list.resource-list__carousel {
      margin-block: var(--ascent-hover-grow);
    }
  }

  .section-resource-list--ascent .product-meta--tag {
    justify-content: center;
  }

  .section-resource-list--ascent .product-meta__badge {
    background: var(--ascent-surface);
    color: var(--ascent-text);
    box-shadow: inset 0 0 0 1.5px var(--ascent-muted);
  }

  .section-resource-list--ascent .product-meta__badge:nth-child(2),
  .section-resource-list--ascent .product-meta__tag {
    background: var(--ascent-text);
    color: var(--color-primary-button-background);
    box-shadow: none;
  }

  .section-resource-list--ascent .product-meta__text {
    color: var(--ascent-text);
  }

  .section-resource-list--ascent .product-meta--hover .product-meta__text {
    color: var(--ascent-muted);
  }

  .section-resource-list--ascent .rating-wrapper {
    --star-fill-color: var(--ascent-text);
    gap: 8px;
    justify-content: center;
  }

  .section-resource-list--ascent .rating-wrapper .rating-count {
    color: var(--ascent-text);
  }

  .section-resource-list--ascent :is(.text-block.title-card, .text-block.title-card > *, product-price) {
    --color: var(--ascent-text);
    color: var(--ascent-text);
  }

  .section-resource-list--ascent product-price .price {
    font-weight: 700;
  }

  .section-resource-list--ascent product-price .compare-at-price {
    color: var(--ascent-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    font-weight: var(--font-body--weight);
  }

  /* Highlighted first card (dark) */
  .section-resource-list--highlight-first :is(.resource-list__slide:first-child, .resource-list--grid > .resource-list__item:first-child) .product-grid__card.product-grid__card {
    --ascent-text: var(--ascent-highlight-text);
    --ascent-muted: var(--ascent-highlight-muted);

    background-color: var(--ascent-highlight-bg);
  }

  .section-resource-list--highlight-first :is(.resource-list__slide:first-child, .resource-list--grid > .resource-list__item:first-child) .product-meta__badge:first-child {
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    box-shadow: none;
  }

  .section-resource-list--highlight-first :is(.resource-list__slide:first-child, .resource-list--grid > .resource-list__item:first-child) .product-meta__tag {
    background: transparent;
    color: var(--color-primary-button-background);
    box-shadow: inset 0 0 0 1px var(--color-primary-button-background);
  }

  .section-resource-list--highlight-first :is(.resource-list__slide:first-child, .resource-list--grid > .resource-list__item:first-child) .rating-wrapper {
    --star-fill-color: var(--color-primary-button-background);
  }

  .section-resource-list--highlight-first :is(.resource-list__slide:first-child, .resource-list--grid > .resource-list__item:first-child) .rating-wrapper .rating-count {
    color: var(--ascent-muted);
    font-weight: 700;
  }

  /* Hover description: collapsed (cancels the flex gap) until the card is hovered */
  .section-resource-list--ascent .product-meta--hover {
    height: 0;
    overflow: hidden;
    flex-shrink: 0;
    margin-block-end: calc(-1 * var(--product-card-gap));
    opacity: 0;
    transition: height 0.3s var(--ease-out-quad, ease), margin-block-end 0.3s var(--ease-out-quad, ease), opacity 0.2s;
  }

  @media screen and (min-width: 750px) and (hover: hover) {
    .section-resource-list--ascent .resource-list__slide:has(.product-card:hover) {
      margin-block: calc(-1 * var(--ascent-hover-grow));
    }

    .section-resource-list--ascent .product-card:hover .product-meta--hover {
      height: var(--product-meta-height);
      margin-block-end: 4px;
      opacity: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .section-resource-list--ascent .resource-list__carousel .resource-list__slide {
      --slide-width: var(--ascent-slide-width-mobile);
    }

    .section-resource-list--ascent .product-grid__card.product-grid__card {
      padding-block: 24px;
      padding-inline: 12px;
    }

    .section-resource-list--ascent .product-grid__card .card-gallery {
      width: min(224px, 100%);
    }

    .section-resource-list--ascent .product-meta--badges {
      inset-block-start: 8px;
    }

    .section-resource-list--ascent .product-meta--text:not(.product-meta--hover) .product-meta__text {
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .section-resource-list--ascent product-price.text-block > * {
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .section-resource-list--ascent product-price .compare-at-price {
      font-size: 0.75rem;
    }

    .section-resource-list--ascent.section-resource-list--ascent {
      padding-block: var(--ascent-padding-block-start-mobile) var(--ascent-padding-block-end-mobile);
      row-gap: var(--ascent-gap-mobile);
    }

    .section-resource-list--ascent .section-resource-list__header :is(.body-lg, .body-lg > *) {
      font-size: 0.875rem;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-resource-list--ascent :is(.product-grid__card, .product-meta--hover) {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type != 'editorial' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.card_style"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "ascent",
          "label": "t:options.ascent"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "highlight_first",
      "label": "t:settings.highlight_first_card",
      "default": false,
      "visible_if": "{{ section.settings.card_style == 'ascent' }}"
    },
    {
      "type": "range",
      "id": "slide_width",
      "label": "t:settings.card_width_desktop",
      "min": 238,
      "max": 478,
      "step": 4,
      "unit": "px",
      "default": 338,
      "visible_if": "{{ section.settings.card_style == 'ascent' }}"
    },
    {
      "type": "range",
      "id": "slide_width_mobile",
      "label": "t:settings.card_width_mobile",
      "min": 200,
      "max": 360,
      "step": 2,
      "unit": "px",
      "default": 300,
      "visible_if": "{{ section.settings.card_style == 'ascent' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#1a1a1a",
      "visible_if": "{{ section.settings.card_style == 'ascent' }}"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "t:settings.muted_text_color",
      "default": "#696969",
      "visible_if": "{{ section.settings.card_style == 'ascent' }}"
    },
    {
      "type": "color",
      "id": "highlight_background",
      "label": "t:settings.highlight_background",
      "default": "#1a1a1a",
      "visible_if": "{{ section.settings.card_style == 'ascent' }}"
    },
    {
      "type": "color",
      "id": "highlight_text",
      "label": "t:settings.highlight_text",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.card_style == 'ascent' }}"
    },
    {
      "type": "color",
      "id": "highlight_muted",
      "label": "t:settings.highlight_muted_text",
      "default": "#d0d0d0",
      "visible_if": "{{ section.settings.card_style == 'ascent' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.products_grid",
      "category": "t:categories.products",
      "settings": {
        "collection": "",
        "max_products": 8,
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 8,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_list_text": {
              "type": "_product-list-text",
              "name": "t:names.collection_title",
              "settings": {
