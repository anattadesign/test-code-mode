{% comment %}
  Section contract.
  "Shop by goal" on a dark background: heading, a rail of goal cards (image + two-line
  label linking to a collection), and an optional protein-calculator call-out.
  @example
  <!-- Add Goal blocks and link each to a collection; toggle the calculator call-out -->
{% endcomment %}
{% render 'ap-base' %}

{%- assign s = section.settings -%}
<div class="ap-section ap-goals ap-pad" style="--ap-goals-bg: {{ s.background }};">
  <div class="ap-goals__wrap">
    <div class="ap-container ap-goals__head">
      {%- if s.eyebrow != blank -%}
        <p class="ap-eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="ap-h2">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ap-rail-scroller class="ap-goals__scroller">
      <div class="ap-rail ap-goals__rail" data-rail>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <a href="{{ b.link | default: '#' }}" class="ap-goal" {{ block.shopify_attributes }}>
            {% render 'ap-image',
              image: b.image,
              fallback: b.fallback,
              fallback_width: 700,
              fallback_height: 875,
              alt: '',
              class: 'ap-img-cover ap-goal__img',
              sizes: '(min-width: 990px) 312px, 236px',
              widths: '240, 320, 480, 640'
            %}
            <span class="ap-goal__bar">
              <span class="ap-goal__label">
                <span>{{ b.line_1 | escape }}</span>
                {%- if b.line_2 != blank -%}<span>{{ b.line_2 | escape }}</span>{%- endif -%}
              </span>
              <span class="ap-goal__icon" aria-hidden="true">{% render 'ap-icon', name: 'arrow-up-right' %}</span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </ap-rail-scroller>
  </div>

  {%- if s.show_calculator -%}
    <div class="ap-container">
      <div class="ap-calc">
        <div class="ap-calc__top">
          <span class="ap-calc__icon" aria-hidden="true">{% render 'ap-icon', name: 'calculator' %}</span>
          <div class="ap-calc__head">
            {%- if s.calc_eyebrow != blank -%}
              <p class="ap-calc__eyebrow">{{ s.calc_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if s.calc_heading != blank -%}
              <h3 class="ap-calc__title">{{ s.calc_heading | escape }}</h3>
            {%- endif -%}
          </div>
        </div>
        {%- if s.calc_text != blank -%}
          <p class="ap-calc__text">{{ s.calc_text | escape }}</p>
        {%- endif -%}
        {%- if s.calc_button_label != blank -%}
          <a href="{{ s.calc_button_link | default: '#' }}" class="ap-btn ap-btn--primary ap-btn--icon ap-btn--small-icon ap-calc__btn">
            <span>{{ s.calc_button_label | escape }}</span>
            <span class="ap-btn__icon">{% render 'ap-icon', name: 'arrow-up-right' %}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  html .ap-goals {
    display: flex;
    flex-direction: column;
    gap: 32px;
    background: var(--ap-goals-bg);
    color: var(--ap-white);
  }

  html .ap-goals__wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  html .ap-goals__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  html .ap-goals__head .ap-eyebrow {
    color: var(--ap-grey-300);
  }

  html .ap-goals__rail {
    --ap-rail-gap: 12px;
  }

  html .ap-goal {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 236px;
    height: 295px;
    border-radius: 12px;
    overflow: hidden;
    color: var(--ap-white);
    text-decoration: none;
    isolation: isolate;
  }

  html .ap-goal::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgb(102 102 102 / 0) 0%, rgb(0 0 0 / 0.5) 100%);
  }

  html .ap-goal__img {
    z-index: -1;
    transition: transform 0.6s var(--ap-ease);
  }

  html .ap-goal:hover .ap-goal__img {
    transform: scale(1.05);
  }

  html .ap-goal__bar {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    background: rgb(217 217 217 / 0.2);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  html .ap-goal__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--ap-font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 22px;
  }

  html .ap-goal__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--ap-yellow);
    color: var(--ap-ink);
    transition: transform 0.25s var(--ap-ease);
  }

  html .ap-goal__icon .ap-icon {
    width: 20px;
    height: 20px;
  }

  html .ap-goal:hover .ap-goal__icon {
    transform: rotate(45deg);
  }

  /* Calculator */
  html .ap-calc {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 0.5px solid var(--ap-yellow);
    border-radius: 6px;
    background: var(--ap-ink);
    color: var(--ap-off-white);
  }

  html .ap-calc__top {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  html .ap-calc__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 4px;
    background: var(--ap-yellow);
    color: var(--ap-ink);
  }

  html .ap-calc__icon .ap-icon {
    width: 30px;
    height: 30px;
  }

  html .ap-calc__head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  html .ap-calc__eyebrow {
    margin: 0;
    font-family: var(--ap-font-mono);
    font-weight: 600;
    font-size: 12px;
    line-height: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  html .ap-calc__title {
    margin: 0;
    font-family: var(--ap-font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 24px;
  }

  html .ap-calc__text {
    margin: 0;
    font-size: 14px;
    line-height: 21px;
    color: var(--ap-grey-100);
  }

  html .ap-calc__btn {
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    html .ap-goals {
      gap: 40px;
    }

    html .ap-goals__wrap {
      gap: 32px;
    }

    html .ap-goals__rail {
      --ap-rail-gap: 21px;
      padding-inline-start: max(var(--ap-gutter), calc((100% - var(--ap-max)) / 2));
    }

    html .ap-goal {
      width: 312px;
      height: 390px;
    }

    html .ap-goal__label {
      font-size: 26px;
      line-height: 26px;
    }

    html .ap-calc {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-rows: auto auto;
      align-items: center;
      column-gap: 28px;
      row-gap: 6px;
      padding: 24px 32px;
    }

    html .ap-calc__top {
      display: contents;
    }

    html .ap-calc__icon {
      grid-row: 1 / span 2;
      width: 88px;
      height: 88px;
    }

    html .ap-calc__icon .ap-icon {
      width: 40px;
      height: 40px;
    }

    html .ap-calc__head {
      align-self: end;
    }

    html .ap-calc__title {
      font-size: 24px;
      line-height: 25px;
    }

    html .ap-calc__text {
      grid-column: 2;
      align-self: start;
      line-height: 20px;
      color: var(--ap-off-white);
    }

    html .ap-calc__btn {
      grid-column: 3;
      grid-row: 1 / span 2;
      width: auto;
      min-width: 230px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ascent shop by goal",
  "class": "ap-goals-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by goals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Moves You?" },
    { "type": "color", "id": "background", "label": "Background", "default": "#1a1a1a" },
    { "type": "header", "content": "Protein calculator call-out" },
    { "type": "checkbox", "id": "show_calculator", "label": "Show call-out", "default": true },
    { "type": "text", "id": "calc_eyebrow", "label": "Eyebrow", "default": "Protein calculator" },
    { "type": "text", "id": "calc_heading", "label": "Heading", "default": "Find out how much protein you actually need." },
    { "type": "textarea", "id": "calc_text", "label": "Text", "default": "Answer a few questions about your training and we’ll point you to a daily target and the goal to shop. Takes about a minute." },
    { "type": "text", "id": "calc_button_label", "label": "Button label", "default": "Calculate now" },
    { "type": "url", "id": "calc_button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Goal",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback",
          "label": "Design image (when no image picked)",
          "options": [
            { "value": "ap-goal-strength.webp", "label": "Strength" },
            { "value": "ap-goal-recover.webp", "label": "Recovery" },
            { "value": "ap-goal-weight.webp", "label": "Weight" },
            { "value": "ap-goal-mobility.webp", "label": "Mobility" }
          ],
          "default": "ap-goal-strength.webp"
        },
        { "type": "text", "id": "line_1", "label": "Line 1", "default": "Build" },
        { "type": "text", "id": "line_2", "label": "Line 2", "default": "Strength" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ascent shop by goal",
      "blocks": [
        { "type": "goal", "settings": { "fallback": "ap-goal-strength.webp", "line_1": "Build", "line_2": "Strength" } },
        { "type": "goal", "settings": { "fallback": "ap-goal-recover.webp", "line_1": "Recover", "line_2": "Faster" } },
        { "type": "goal", "settings": { "fallback": "ap-goal-weight.webp", "line_1": "Manage", "line_2": "Weight" } },
        { "type": "goal", "settings": { "fallback": "ap-goal-mobility.webp", "line_1": "Support", "line_2": "Mobility" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
