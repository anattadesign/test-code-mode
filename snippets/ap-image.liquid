{%- doc -%}
  Renders a merchant-picked image, or a bundled design asset when the picker is empty
  so a fresh section still matches the design.

  @param {image} [image] - Image picked in the editor
  @param {string} [fallback] - Asset filename used when `image` is blank
  @param {number} [fallback_width] - Intrinsic width of the fallback asset
  @param {number} [fallback_height] - Intrinsic height of the fallback asset
  @param {string} [alt] - Alt text; defaults to the image alt
  @param {string} [class] - CSS class
  @param {string} [sizes] - Sizes attribute
  @param {string} [widths] - Comma-separated widths for srcset
  @param {boolean} [eager] - Load eagerly with high priority

  @example
  {% render 'ap-image', image: section.settings.image, fallback: 'ap-hero-desktop.webp', fallback_width: 2400, fallback_height: 1325, sizes: '100vw', eager: true %}
{%- enddoc -%}
{%- liquid
  assign loading = 'lazy'
  assign priority = 'auto'
  if eager
    assign loading = 'eager'
    assign priority = 'high'
  endif
  assign image_widths = widths | default: '375, 550, 750, 1100, 1500, 1780, 2000'
-%}
{%- if image != blank -%}
  {%- assign alt_text = alt | default: image.alt -%}
  {{ image | image_url: width: 2400 | image_tag: class: class, sizes: sizes, widths: image_widths, loading: loading, fetchpriority: priority, alt: alt_text }}
{%- elsif fallback != blank -%}
  <img
    src="{{ fallback | asset_url }}"
    {% if class != blank %}class="{{ class }}"{% endif %}
    alt="{{ alt | escape }}"
    width="{{ fallback_width | default: 1000 }}"
    height="{{ fallback_height | default: 1000 }}"
    loading="{{ loading }}"
    fetchpriority="{{ priority }}"
    decoding="async"
  >
{%- endif -%}
