{%- doc -%}
  Renders an Ascent icon as inline SVG. Icons inherit currentColor.

  @param {string} name - Icon name: logo, mark, usp-flavours, usp-certified, usp-tested, usp-gluten, arrow-left, arrow-right, arrow-up-right, play, calculator, north-star, search-arrow, verified, check, tick, close, close-small, filters, chevron-down, chevron-left, chevron-right
  @param {string} [class] - Extra CSS class

  @example
  {% render 'ap-icon', name: 'arrow-right', class: 'ap-carousel__icon' %}
{%- enddoc -%}
{%- capture cls -%}ap-icon ap-icon--{{ name }} {{ class }}{%- endcapture -%}
