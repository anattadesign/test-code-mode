{%- doc -%}
  Intended for use in a block similar to the button block.
  AP-51: adds the Ascent size modifiers (button--sm / --md / --lg) and the optional
  trailing icon. Markup matches snippets/ap-button.liquid.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

{%- liquid
  assign style_class = block_settings.style_class | default: 'button'

  case block_settings.button_size
    when 'small'
      assign size_class = 'button--sm'
    when 'large'
      assign size_class = 'button--lg'
    else
      assign size_class = 'button--md'
  endcase

  assign has_icon = false
  if block_settings.show_icon and style_class != 'button-unstyled'
    assign has_icon = true
  endif
-%}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ style_class }}
    {{ style_class }}--{{ block.id }}
    {% unless style_class == 'button-unstyled' %}{{ size_class }}{% endunless %}
    {% if has_icon %}button--icon{% endif %}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {%- if has_icon -%}
    <span class="button__label">{{ block_settings.label }}</span>
    <span class="button__icon" aria-hidden="true">
      {%- render 'ap-button-icon' -%}
    </span>
  {%- elsif style_class == 'button-tertiary' -%}
    <span class="button__label">{{ block_settings.label }}</span>
  {%- else -%}
    {{ block_settings.label }}
  {%- endif -%}
</a>
