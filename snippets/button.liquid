{%- doc -%}
  Intended for use in a block similar to the button block.
  Reads style_class, button_size, secondary_tone and show_arrow from the block settings
  (Ascent button system: Primary, Secondary, Tertiary, Dark × Small/Medium/Large, optional arrow).

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign style_class = block_settings.style_class | default: 'button'
  assign button_size = block_settings.button_size | default: 'medium'

  capture button_modifiers
    if style_class != 'button-unstyled'
      echo ' button--' | append: button_size
      if block_settings.show_arrow
        echo ' button--arrow'
      endif
    endif
    if style_class == 'button-secondary' and block_settings.secondary_tone != 'palette'
      echo ' button-secondary--accent'
    endif
  endcapture
%}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ style_class }}
    {{ style_class }}--{{ block.id }}
    {{ button_modifiers }}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {%- if block_settings.show_arrow and style_class != 'button-unstyled' -%}
    <span class="button__label">{{ block_settings.label }}</span>
    <span class="button__arrow" aria-hidden="true">
      {%- comment -%} Figma "Icon" (arrow up-right, 20×20) {%- endcomment -%}
      <svg viewBox="0 0 20 20" focusable="false"><path d="M6.843 4.736v1.053h6.626l-8.732 8.731.742.742 8.732-8.731v6.626h1.053V4.736z" fill="currentColor"/></svg>
    </span>
  {%- else -%}
    {{ block_settings.label }}
  {%- endif -%}
</a>
