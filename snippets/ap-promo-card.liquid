{%- doc -%}
  AP-62 · Promo tile shown inside product grids (Figma "Promo" 1906:24387 desktop ·
  1906:22931 mobile). Same cell as a product card on desktop; full row (≈350 × 203)
  on mobile. Colour fill (Ascent yellow by default), optional image underneath with
  an optional scrim, then eyebrow, heading, text and a button.

  @param {object} settings - Block settings: image, image_mobile, eyebrow, heading, text,
    button_label, link, button_style, background_color, text_color, scrim_opacity
  @param {string} [id] - Unique id (block id)
{%- enddoc -%}

{%- liquid
  assign image = settings.image
  assign image_mobile = settings.image_mobile | default: image
  assign scrim_alpha = settings.scrim_opacity | divided_by: 100.0
-%}

<div
  class="ap-promo{% if image != blank or image_mobile != blank %} ap-promo--has-image{% endif %}"
  id="ApPromo-{{ id }}"
  style="--ap-promo-bg: {{ settings.background_color }}; --ap-promo-text: {{ settings.text_color }}; --ap-promo-scrim: rgb(26 26 26 / {{ scrim_alpha }});"
>
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 900
      | image_tag:
        widths: '360, 450, 600, 900',
        sizes: '(min-width: 750px) 340px, 1px',
        loading: 'lazy',
        alt: image.alt | default: '',
        class: 'ap-promo__image ap-promo__image--desktop'
    }}
  {%- endif -%}
  {%- if image_mobile != blank -%}
    {{
      image_mobile
      | image_url: width: 1000
      | image_tag:
        widths: '390, 600, 780, 1000',
        sizes: '(min-width: 750px) 1px, 100vw',
        loading: 'lazy',
        alt: image_mobile.alt | default: '',
        class: 'ap-promo__image ap-promo__image--mobile'
    }}
  {%- endif -%}
  {%- if scrim_alpha > 0 -%}
    <span class="ap-promo__scrim" aria-hidden="true"></span>
  {%- endif -%}

  <div class="ap-promo__content">
    {%- if settings.eyebrow != blank -%}
      <p class="ap-promo__eyebrow ap-label-sm">{{ settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if settings.heading != blank -%}
      <h3 class="ap-promo__heading h4">{{ settings.heading }}</h3>
    {%- endif -%}
    {%- if settings.text != blank -%}
      <p class="ap-promo__text">{{ settings.text }}</p>
    {%- endif -%}
    {%- if settings.button_label != blank -%}
      <a
        class="{{ settings.button_style | default: 'button-dark' }} ap-promo__button"
        {% if settings.link != blank %}
          href="{{ settings.link }}"
        {% else %}
          role="link" aria-disabled="true"
        {% endif %}
      >
        {{- settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ap-promo {
    position: relative;
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 12.6875rem;
    overflow: hidden;
    border-radius: var(--ap-card-corner-radius, 16px);
    background: var(--ap-promo-bg);
    color: var(--ap-promo-text);
    isolation: isolate;
  }

  .ap-promo__image,
  .ap-promo__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .ap-promo__scrim {
    background: var(--ap-promo-scrim);
  }

  .ap-promo__image--desktop {
    display: none;
  }

  .ap-promo__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .ap-promo__content > * {
    margin: 0;
    color: inherit;
  }

  .ap-promo__eyebrow {
    text-transform: uppercase;
  }

  .ap-promo__text {
    font-size: var(--font-paragraph--size, 0.875rem);
    line-height: 1.5;
    max-inline-size: 22rem;
  }

  .ap-promo__button {
    margin-block-start: auto;
  }

  @media screen and (min-width: 750px) {
    .ap-promo {
      min-block-size: 100%;
    }

    .ap-promo__image--desktop {
      display: block;
    }

    .ap-promo__image--mobile {
      display: none;
    }

    .ap-promo__content {
      padding: 1.5rem 1.25rem;
      gap: 0.75rem;
    }

    .ap-promo__button {
      inline-size: 100%;
    }
  }
{% endstylesheet %}
