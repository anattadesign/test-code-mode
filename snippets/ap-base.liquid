{%- doc -%}
  Shared Ascent homepage foundation: design tokens, typography, buttons, badges and
  the rail/carousel controls used by every `ap-*` section. Render it once at the top
  of each `ap-*` section so its stylesheet and script are delivered with the section.

  @example
  {% render 'ap-base' %}
{%- enddoc -%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap">
<script src="{{ 'ap-home.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
  :root {
    --ap-yellow: #fbec00;
    --ap-ink: #1a1a1a;
    --ap-ink-2: #171717;
    --ap-white: #ffffff;
    --ap-off-white: #f8f8f8;
    --ap-grey-100: #d0d0d0;
    --ap-grey-300: #a9a9a9;
    --ap-grey-400: #919191;
    --ap-grey-500: #696969;
    --ap-line: #414141;
    --ap-font-display: var(--font-heading--family);
    --ap-font-body: var(--font-body--family);
    --ap-font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --ap-gutter: 20px;
    --ap-section-pad: 48px;
    --ap-max: 1312px;
    --ap-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media screen and (min-width: 990px) {
    :root {
      --ap-gutter: 64px;
      --ap-section-pad: 80px;
    }
  }

  .ap-section {
    position: relative;
    font-family: var(--ap-font-body);
    color: var(--ap-ink);
    overflow: hidden;
  }

  .ap-section *,
  .ap-section *::before,
  .ap-section *::after {
    box-sizing: border-box;
  }

  .ap-container {
    width: 100%;
    max-width: calc(var(--ap-max) + var(--ap-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--ap-gutter);
  }

  .ap-pad {
    padding-block: var(--ap-section-pad);
  }

  /* Typography */
  .ap-eyebrow {
    margin: 0;
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ap-grey-500);
  }

  .ap-h1,
  .ap-h2,
  .ap-h3,
  .ap-h4 {
    margin: 0;
    font-family: var(--ap-font-display);
    font-weight: 700;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .ap-h1 {
    font-size: 44px;
    line-height: 40px;
    letter-spacing: -0.034em;
  }

  .ap-h2 {
    font-size: 32px;
    line-height: 30px;
  }

  .ap-h3 {
    font-size: 26px;
    line-height: 26px;
  }

  .ap-h4 {
    font-size: 20px;
    line-height: 24px;
  }

  .ap-h1 p,
  .ap-h2 p,
  .ap-h3 p {
    margin: 0;
  }

  .ap-body {
    margin: 0;
    font-size: 14px;
    line-height: 21px;
  }

  .ap-body p {
    margin: 0;
  }

  .ap-muted {
    color: var(--ap-grey-500);
  }

  @media screen and (min-width: 990px) {
    .ap-eyebrow {
      font-size: 14px;
      line-height: 20px;
    }

    .ap-h1 {
      font-size: 64px;
      line-height: 60px;
      letter-spacing: -0.025em;
    }

    .ap-h2 {
      font-size: 48px;
      line-height: 45px;
    }

    .ap-body {
      font-size: 16px;
      line-height: 22px;
    }
  }

  /* Buttons */
  .ap-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 24px;
    border: 1.5px solid transparent;
    border-radius: 999px;
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 16px;
    line-height: 19px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.2s var(--ap-ease), background-color 0.2s, color 0.2s, box-shadow 0.2s;
  }

  .ap-btn:hover {
    transform: translateY(-1px);
  }

  .ap-btn:focus-visible {
    outline: 2px solid var(--ap-yellow);
    outline-offset: 3px;
  }

  .ap-btn--primary {
    background: var(--ap-yellow);
    color: var(--ap-ink);
  }

  .ap-btn--dark {
    background: var(--ap-ink);
    color: var(--ap-yellow);
  }

  .ap-btn--outline {
    background: transparent;
    border-color: var(--ap-yellow);
    color: var(--ap-yellow);
  }

  .ap-btn--icon {
    min-height: 56px;
    padding: 6px 6px 6px 24px;
    justify-content: space-between;
  }

  .ap-btn__icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--ap-ink);
    color: var(--ap-yellow);
    transition: transform 0.25s var(--ap-ease);
  }

  .ap-btn--dark .ap-btn__icon,
  .ap-btn--outline .ap-btn__icon {
    background: var(--ap-yellow);
    color: var(--ap-ink);
  }

  .ap-btn:hover .ap-btn__icon {
    transform: rotate(45deg);
  }

  .ap-btn--small-icon {
    min-height: 48px;
    padding: 6px 6px 6px 20px;
  }

  .ap-btn--small-icon .ap-btn__icon {
    width: 36px;
    height: 36px;
  }

  .ap-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 14px;
    line-height: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .ap-link .ap-icon {
    transition: transform 0.2s var(--ap-ease);
  }

  .ap-link:hover .ap-icon {
    transform: translate(2px, -2px);
  }

  /* Badges and tags */
  .ap-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border: 1.5px solid transparent;
    border-radius: 999px;
    font-family: var(--ap-font-mono);
    font-weight: 700;
    font-size: 10px;
    line-height: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media screen and (min-width: 990px) {
    .ap-badge {
      font-size: 12px;
      line-height: 17px;
    }
  }

  .ap-badge--yellow {
    background: var(--ap-yellow);
    color: var(--ap-ink);
  }

  .ap-badge--dark {
    background: var(--ap-ink);
    color: var(--ap-yellow);
  }

  .ap-badge--outline {
    background: var(--ap-white);
    border-color: var(--ap-grey-500);
    color: var(--ap-ink);
  }

  /* Horizontal rail + nav */
  .ap-rail {
    display: flex;
    gap: var(--ap-rail-gap, 12px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--ap-rail-pad, var(--ap-gutter));
    padding-inline: var(--ap-rail-pad, var(--ap-gutter));
    scrollbar-width: none;
  }

  .ap-rail::-webkit-scrollbar {
    display: none;
  }

  .ap-rail > * {
    flex: none;
    scroll-snap-align: start;
    min-width: 0;
  }

  .ap-rail-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-inline: var(--ap-gutter);
  }

  .ap-rail-nav[hidden] {
    display: none;
  }

  .ap-rail-nav__btn {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    color: currentColor;
    cursor: pointer;
  }

  .ap-rail-nav__btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .ap-rail-nav__track {
    position: relative;
    flex: 1;
    height: 4px;
    border-radius: 999px;
    background: var(--ap-track, var(--ap-grey-100));
    overflow: hidden;
  }

  .ap-rail-nav__thumb {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--ap-thumb-size, 30%);
    border-radius: 999px;
    background: var(--ap-thumb, var(--ap-ink));
    transform: translateX(var(--ap-thumb-offset, 0));
    transition: transform 0.1s linear;
  }

  @media screen and (min-width: 990px) {
    .ap-rail-nav {
      gap: 24px;
    }
  }

  /* Marquee */
  .ap-marquee {
    display: flex;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .ap-marquee__track {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--ap-marquee-gap, 32px);
    padding-inline-end: var(--ap-marquee-gap, 32px);
    animation: ap-marquee var(--ap-marquee-duration, 30s) linear infinite;
  }

  .ap-marquee:hover .ap-marquee__track {
    animation-play-state: paused;
  }

  @keyframes ap-marquee {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ap-marquee__track {
      animation: none;
    }

    .ap-marquee {
      overflow-x: auto;
    }
  }

  .ap-glass {
    background: rgb(23 23 23 / 0.2);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .ap-visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .ap-img-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}
