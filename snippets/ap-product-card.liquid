{%- doc -%}
  Ascent product card: tag, rating, title, spec line, flavour swatches, price and a
  shop button, with optional badges over the image. Reads rating from the
  `reviews.rating` / `reviews.rating_count` metafields when present.

  @param {product} product - Product to show
  @param {string} [style] - 'light' or 'dark'
  @param {string} [tag] - Small outlined tag above the rating
  @param {string} [spec] - One-line spec under the title
  @param {string} [badge_1] - First badge text
  @param {string} [badge_1_style] - 'yellow', 'dark' or 'outline'
  @param {string} [badge_2] - Second badge text
  @param {string} [badge_2_style] - 'yellow', 'dark' or 'outline'
  @param {string} [rating] - Fallback rating value, e.g. '4.7'
  @param {string} [rating_count] - Fallback review count, e.g. '128'
  @param {string} [button_label] - Button text
  @param {string} [attributes] - Editor attributes for the wrapper

  @example
  {% render 'ap-product-card', product: block.settings.product, style: 'dark', tag: 'Recover', button_label: 'Shop now' %}
{%- enddoc -%}
{%- liquid
  assign card_style = style | default: 'light'

  assign rating_value = product.metafields.reviews.rating.value.rating | default: rating
  assign rating_total = product.metafields.reviews.rating_count.value | default: rating_count

  assign swatch_option = nil
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'flavo'
      assign swatch_option = option
      break
    endif
  endfor
  if swatch_option == nil and product.has_only_default_variant == false
    assign swatch_option = product.options_with_values.first
  endif
-%}
<article class="ap-card ap-card--{{ card_style }}" {{ attributes }}>
  {%- if badge_1 != blank or badge_2 != blank -%}
    <div class="ap-card__badges">
      {%- if badge_1 != blank -%}
        <span class="ap-badge ap-badge--{{ badge_1_style | default: 'yellow' }}">{{ badge_1 | escape }}</span>
      {%- endif -%}
      {%- if badge_2 != blank -%}
        <span class="ap-badge ap-badge--{{ badge_2_style | default: 'dark' }}">{{ badge_2 | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <a href="{{ product.url | default: '#' }}" class="ap-card__media" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image != blank -%}
      {{
        product.featured_image
        | image_url: width: 600
        | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 298px, 224px', alt: '', class: 'ap-card__img'
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'ap-card__img ap-card__placeholder' }}
    {%- endif -%}
  </a>

  <div class="ap-card__content">
    <div class="ap-card__info">
      {%- if tag != blank -%}
        <span class="ap-card__tag">{{ tag | escape }}</span>
      {%- endif -%}

      {%- if rating_value != blank -%}
        <p class="ap-card__rating">
          <span class="ap-card__star" aria-hidden="true">★</span>
          <span class="ap-card__rating-value">
            {{- rating_value | round: 1 -}}
            {%- if rating_total != blank %} ({{ rating_total }}){% endif -%}
          </span>
          <span class="ap-visually-hidden">{{ 'accessibility.rating' | t: rating: rating_value }}</span>
        </p>
      {%- endif -%}

      <h3 class="ap-h4 ap-card__title">
        <a href="{{ product.url | default: '#' }}">{{ product.title | default: 'Product title' | escape }}</a>
      </h3>

      {%- if spec != blank -%}
        <p class="ap-card__spec">{{ spec | escape }}</p>
      {%- endif -%}

      {%- if swatch_option and swatch_option.values.size > 1 -%}
        <div class="ap-card__flavours">
          <span class="ap-card__swatches" aria-hidden="true">
            {%- for value in swatch_option.values limit: 4 -%}
              {%- liquid
                assign swatch_style = ''
                if value.swatch.image
                  assign swatch_url = value.swatch.image | image_url: width: 48
                  assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                elsif value.swatch.color
                  assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                elsif value.variant.featured_image
                  assign swatch_url = value.variant.featured_image | image_url: width: 48
                  assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                endif
              -%}
              <span class="ap-card__swatch" style="{{ swatch_style }}"></span>
            {%- endfor -%}
          </span>
          <span class="ap-card__flavour-label">{{ swatch_option.values.size }} {{ swatch_option.name | escape }}s</span>
        </div>
      {%- endif -%}

      <p class="ap-card__price">
        {%- if product != blank -%}
          <span class="ap-card__price-now">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <s class="ap-card__price-was">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
        {%- else -%}
          <span class="ap-card__price-now">{{ 2499 | money }}</span>
        {%- endif -%}
      </p>
    </div>

    <a href="{{ product.url | default: '#' }}" class="ap-btn ap-btn--primary ap-card__cta">
      {{- button_label | default: 'Shop now' | escape -}}
      <span class="ap-visually-hidden">: {{ product.title | escape }}</span>
    </a>
  </div>
</article>
