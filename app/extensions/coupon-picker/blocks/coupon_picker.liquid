{% render 'coupon-picker', block: block, context: 'block' %}

{% schema %}
{
  "name": "Coupon picker",
  "target": "section",
  "stylesheet": "coupon-picker.css",
  "javascript": "coupon-picker.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty for “Available coupons”."
    },
    {
      "type": "checkbox",
      "id": "show_manual_entry",
      "label": "Show manual code entry",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "refresh_mode",
      "label": "After applying a coupon",
      "options": [
        { "value": "events", "label": "Update the cart in place" },
        { "value": "reload", "label": "Reload the page" }
      ],
      "default": "events",
      "info": "Update in place works with Horizon and themes that support Shopify storefront events. Pick reload for other themes."
    }
  ]
}
{% endschema %}
