{
  "name": "app",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --config dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy --config shopify.app.toml",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "wrangler types --strict-vars=false && react-router typegen && tsc --noEmit",
    "test": "vitest run app",
    "test:functions": "npm run test --workspace extensions/tip-price --workspace extensions/tip-guard -- --run",
    "build:theme": "esbuild theme-src/coupon-picker.js --minify --target=es2019 --outfile=extensions/coupon-picker/assets/coupon-picker.js \"--banner:js=/* eslint-disable */ /* Built from theme-src/coupon-picker.js by npm run build:theme. Do not edit. */\"",
    "predev": "npm run build:theme",
    "predeploy": "npm run build:theme",
    "cf-typegen": "wrangler types --strict-vars=false",
    "deploy:worker": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply coupons-tipping-sessions --remote",
    "deploy:dev": "shopify app deploy --config dev"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-api": "^15.0.1",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage": "^7.0.1",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.155.0"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  }
}
